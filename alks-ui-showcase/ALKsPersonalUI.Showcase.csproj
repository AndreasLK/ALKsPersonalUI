<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>

		<StaticWebAssetsFingerprintContent>false</StaticWebAssetsFingerprintContent>
		<StaticWebAssetFingerprintingEnabled>false</StaticWebAssetFingerprintingEnabled>
		<!-- Prevent stale pre-compressed .gz assets (e.g., dotnet.js.gz) on incremental builds when fingerprinting is disabled -->
		<DisableBuildCompression>true</DisableBuildCompression>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.*" />
		<!-- Use local library source inside the monorepo; fall back to NuGet for standalone Docker builds -->
		<ProjectReference Include="..\ALKsPersonalUI\ALKsPersonalUI.csproj" Condition="Exists('..\ALKsPersonalUI\ALKsPersonalUI.csproj')" />
		<PackageReference Include="ALKsPersonalUI" Version="3.1.5" Condition="!Exists('..\ALKsPersonalUI\ALKsPersonalUI.csproj')" />
	</ItemGroup>

</Project>