@page "/playground"
@using System.Globalization
@using System.Text.RegularExpressions
@inject ToastService Toast
@inject IJSRuntime JS

<PageTitle>ALK's Personal UI - Live UI Playground & Autocomplete Sandbox</PageTitle>

<Column Modifier="@(UIModifier.New.FillMaxWidth())" Gap="1.5rem">
    <TitledWindow Title="Live Client-Side UI Playground (Real Blazor Components + Autocomplete)"
                  Modifier="@ShowcaseStyles.SectionWindow">
        <HeaderActions>
            <Pill Variant="Pill.PillVariant.Success" Text="100% Client-Side WASM" />
            <Pill Variant="Pill.PillVariant.Accent" Text="Live AST + IntelliSense" />
        </HeaderActions>
        <ChildContent>
            <ALKsPersonalUI.Layout.Text Variant="TypographyVariant.Body"
                                        Muted="true"
                                        Value="Type ALKsPersonalUI Razor markup below. The sandbox parses your component tree and UIModifier chains live in the browser and mounts real interactive Blazor components on the right. Type '<' for components, Space inside a tag for parameters, or '.' inside UIModifier.New for fluent methods." />

            @* STARTER TEMPLATES BAR *@
            <Window Modifier="@(UIModifier.New.FillMaxWidth().Padding(12, 16).Background("var(--ui-bg-header)"))">
                <Row HorizontalArrangement="Arrangement.SpaceBetween" VerticalAlignment="VerticalAlignment.Center" Wrap="true" Gap="0.75rem" Modifier="@(UIModifier.New.FillMaxWidth())">
                    <Row Gap="0.45rem" Wrap="true" VerticalAlignment="VerticalAlignment.Center">
                        <ALKsPersonalUI.Layout.Text Variant="TypographyVariant.Caption" Weight="FontWeight.Bold" Value="Load Starter Template:" />
                        @foreach (var template in _templates)
                        {
                            <Pill Active="@(_activeTemplateName == template.Name)"
                                  Text="@template.Name"
                                  OnClick="@(() => LoadTemplate(template))" />
                        }
                    </Row>
                    <Row Gap="0.5rem" VerticalAlignment="VerticalAlignment.Center">
                        <ActionButton Size="ActionButton.ButtonSize.Small"
                                      Variant="ActionButton.ButtonVariant.Outline"
                                      Modifier="@ShowcaseStyles.CopyButton"
                                      Text="Copy Razor Markup"
                                      OnClick="@(() => ShowcaseStyles.CopyAsync(JS, Toast, _markupCode, "Playground markup"))" />
                    </Row>
                </Row>
            </Window>

            <Grid MinColumnWidth="440px" Gap="1.5rem">
                @* LEFT: CODE EDITOR + AUTOCOMPLETE BAR *@
                <Window Modifier="@ShowcaseStyles.FullHeightCardWindow">
                    <Column Gap="0.65rem" Modifier="@(UIModifier.New.FillMaxWidth().Weight(1))">
                        <Row HorizontalArrangement="Arrangement.SpaceBetween" VerticalAlignment="VerticalAlignment.Center" Modifier="@(UIModifier.New.FillMaxWidth())">
                            <Row Gap="0.5rem" VerticalAlignment="VerticalAlignment.Center">
                                <ALKsPersonalUI.Layout.Text Variant="TypographyVariant.Subtitle" Weight="FontWeight.Bold" Value="1. Live Razor & UIModifier Editor" />
                                <Pill Variant="Pill.PillVariant.Neutral" Text="@($"Context: {_activeContextLabel}")" />
                            </Row>
                            <ALKsPersonalUI.Layout.Text Variant="TypographyVariant.Caption" Muted="true" Value="Click any suggestion below or press Tab/Alt+Enter" />
                        </Row>

                        @* INTELLISENSE / AUTOCOMPLETE SUGGESTION DECK *@
                        <Window Modifier="@(UIModifier.New.FillMaxWidth().Padding(10, 12).Gap(8).Background("var(--ui-bg-header)").BorderColor("var(--ui-accent)"))">
                            <Row HorizontalArrangement="Arrangement.SpaceBetween" VerticalAlignment="VerticalAlignment.Center" Modifier="@(UIModifier.New.FillMaxWidth())">
                                <ALKsPersonalUI.Layout.Text Variant="TypographyVariant.Caption" Weight="FontWeight.Bold" Color="var(--ui-accent)" Value="@($"Autocomplete Suggestions ({_suggestions.Count})")" />
                                <ALKsPersonalUI.Layout.Text Variant="TypographyVariant.Caption" Muted="true" Value="@(_suggestions.Count > 0 ? _suggestions[_selectedSuggestionIndex].Description : string.Empty)" />
                            </Row>
                            <Row Gap="0.35rem" Wrap="true" Modifier="@(UIModifier.New.FillMaxWidth().MaxHeight(92).VerticalScroll())">
                                @if (_suggestions.Count == 0)
                                {
                                    <ALKsPersonalUI.Layout.Text Variant="TypographyVariant.Caption" Muted="true" Value="Move cursor inside a <Tag> or UIModifier.New. chain to see completions..." />
                                }
                                else
                                {
                                    @for (int index = 0; index < _suggestions.Count; index++)
                                    {
                                        var capturedIndex = index;
                                        var item = _suggestions[index];
                                        <Pill Active="@(capturedIndex == _selectedSuggestionIndex)"
                                              Text="@item.DisplayLabel"
                                              OnClick="@(() => ApplySuggestionAsync(item))" />
                                    }
                                }
                            </Row>
                        </Window>

                        <textarea @ref="_editorRef"
                                  value="@_markupCode"
                                  @oninput="HandleEditorInputAsync"
                                  @onkeyup="HandleEditorCursorMoveAsync"
                                  @onclick="HandleEditorCursorMoveAsync"
                                  @onkeydown="HandleEditorKeyDownAsync"
                                  spellcheck="false"
                                  style="width: 100%; min-height: 360px; flex: 1 1 auto; resize: vertical; box-sizing: border-box; background-color: var(--ui-bg-header); color: #93c5fd; border: 1px solid var(--ui-border); border-radius: var(--ui-radius-md); padding: 14px 16px; font-family: monospace; font-size: 0.9rem; line-height: 1.55; outline: none;"></textarea>

                        @if (!string.IsNullOrWhiteSpace(_parseWarning))
                        {
                            <Window Modifier="@(UIModifier.New.FillMaxWidth().Padding(10, 14).Background("rgba(239, 68, 68, 0.12)").BorderColor("var(--ui-danger)"))">
                                <ALKsPersonalUI.Layout.Text Variant="TypographyVariant.Caption" Color="var(--ui-danger)" Value="@_parseWarning" />
                            </Window>
                        }
                    </Column>
                </Window>

                @* RIGHT: LIVE INTERACTIVE RENDER STAGE + COMPONENT EXPLAINER *@
                <Window Modifier="@ShowcaseStyles.FullHeightCardWindow">
                    <Column Gap="0.85rem" Modifier="@(UIModifier.New.FillMaxWidth())">
                        <Row HorizontalArrangement="Arrangement.SpaceBetween" VerticalAlignment="VerticalAlignment.Center" Wrap="true" Modifier="@(UIModifier.New.FillMaxWidth())">
                            <ALKsPersonalUI.Layout.Text Variant="TypographyVariant.Subtitle" Weight="FontWeight.Bold" Value="2. Live Interactive Blazor Output" />
                            <ActionButton Size="ActionButton.ButtonSize.Small"
                                          Variant="ActionButton.ButtonVariant.Ghost"
                                          Modifier="@(UIModifier.New.BaseColor("var(--ui-text-muted)").Padding(4, 10))"
                                          Text="Reset Bound State"
                                          OnClick="ResetInteractiveState" />
                        </Row>

                        <Box ContentAlignment="BoxAlignment.Center"
                             Modifier="@(UIModifier.New.FillMaxWidth().MinHeight(280).Padding(20).Background("var(--ui-bg-app)").BorderRadius("var(--ui-radius-md)").Border(1, "var(--ui-border)"))">
                            @RenderParsedTree(_parsedRootNodes)
                        </Box>
                    </Column>

                    <Divider />

                    @* SELF-EXPLAINING AST & MODIFIER BREAKDOWN *@
                    <Column Gap="0.5rem" Modifier="@(UIModifier.New.FillMaxWidth())">
                        <ALKsPersonalUI.Layout.Text Variant="TypographyVariant.Caption" Weight="FontWeight.Bold" Color="var(--ui-accent)" Value="3. Live Architecture Breakdown (What Your Code Is Doing):" />
                        <Window Modifier="@(UIModifier.New.FillMaxWidth().MaxHeight(180).Padding(12, 14).Gap(6).Background("var(--ui-bg-header)").VerticalScroll())">
                            @foreach (var explanation in _liveExplanations)
                            {
                                <Row Gap="0.5rem" VerticalAlignment="VerticalAlignment.Center">
                                    <Pill Variant="Pill.PillVariant.Neutral" Text="@explanation.Tag" />
                                    <ALKsPersonalUI.Layout.Text Variant="TypographyVariant.Caption" Muted="true" Value="@explanation.Summary" />
                                </Row>
                            }
                        </Window>
                    </Column>
                </Window>
            </Grid>
        </ChildContent>
    </TitledWindow>
</Column>

@code {
