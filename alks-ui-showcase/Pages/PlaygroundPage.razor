    protected override void OnInitialized()
    {
        LoadTemplate(_templates[0]);
        UpdateAutocompleteSuggestions(0);
    }

    private void LoadTemplate(PlaygroundTemplate template)
    {
        _activeTemplateName = template.Name;
        _markupCode = template.Code;
        ParseMarkupAndExplain();
    }

    private void ResetInteractiveState()
    {
        _stringState.Clear();
        _numberState.Clear();
        _boolState.Clear();
        Toast.ShowInfo("Playground component state reset!");
    }

    private async Task HandleEditorInputAsync(ChangeEventArgs changeEvent)
    {
        _markupCode = changeEvent.Value?.ToString() ?? string.Empty;
        ParseMarkupAndExplain();
        var caret = await JS.InvokeAsync<int>("alkPlayground.getCaretIndex", _editorRef);
        UpdateAutocompleteSuggestions(caret);
    }

    private async Task HandleEditorCursorMoveAsync()
    {
        var caret = await JS.InvokeAsync<int>("alkPlayground.getCaretIndex", _editorRef);
        UpdateAutocompleteSuggestions(caret);
    }

    private async Task HandleEditorKeyDownAsync(KeyboardEventArgs keyEvent)
    {
        if (_suggestions.Count == 0)
            return;

        if (keyEvent.Key == "Tab" || (keyEvent.AltKey && keyEvent.Key == "Enter"))
        {
            await ApplySuggestionAsync(_suggestions[_selectedSuggestionIndex]);
        }
    }

    private async Task ApplySuggestionAsync(AutocompleteItem suggestion)
    {
        _markupCode = await JS.InvokeAsync<string>(
            "alkPlayground.replaceTokenAtCaret",
            _editorRef,
            _tokenStartIndex,
            _tokenEndIndex,
            suggestion.InsertText,
            suggestion.CursorBackOffset);

        ParseMarkupAndExplain();
        var caret = await JS.InvokeAsync<int>("alkPlayground.getCaretIndex", _editorRef);
        UpdateAutocompleteSuggestions(caret);
    }

    private void UpdateAutocompleteSuggestions(int caretIndex)
    {
        _caretIndex = Math.Clamp(caretIndex, 0, _markupCode.Length);
        _selectedSuggestionIndex = 0;

        var textBeforeCaret = _markupCode[.._caretIndex];

        var lastModifierStart = textBeforeCaret.LastIndexOf("UIModifier.New", StringComparison.Ordinal);
        if (lastModifierStart >= 0)
        {
            var sliceSinceModifier = textBeforeCaret[lastModifierStart..];
            if (!sliceSinceModifier.Contains("\")") && !sliceSinceModifier.Contains("))\""))
            {
                var lastDot = textBeforeCaret.LastIndexOf('.');
                if (lastDot >= lastModifierStart)
                {
                    var partialMethod = textBeforeCaret[(lastDot + 1)..];
                    _tokenStartIndex = lastDot + 1;
                    _tokenEndIndex = _caretIndex;
                    _activeContextLabel = "UIModifier Methods (.)";
                    _suggestions = _modifierSuggestions
                        .Where(m => m.InsertText.StartsWith(partialMethod, StringComparison.OrdinalIgnoreCase))
                        .ToList();
                    return;
                }
            }
        }

        var lastOpenBracket = textBeforeCaret.LastIndexOf('<');
        var lastCloseBracket = textBeforeCaret.LastIndexOf('>');
        if (lastOpenBracket > lastCloseBracket)
        {
            var insideTagText = textBeforeCaret[(lastOpenBracket + 1)..];
            if (!insideTagText.Contains(' ') && !insideTagText.Contains('\n'))
            {
                _tokenStartIndex = lastOpenBracket;
                _tokenEndIndex = _caretIndex;
                _activeContextLabel = "Component Tags (<)";
                _suggestions = _componentSuggestions
                    .Where(c => c.DisplayLabel.TrimStart('<').StartsWith(insideTagText, StringComparison.OrdinalIgnoreCase))
                    .ToList();
                return;
            }

            var tagNameMatch = Regex.Match(insideTagText, @"^([A-Za-z0-9]+)");
            if (tagNameMatch.Success)
            {
                var currentTag = tagNameMatch.Groups[1].Value;
                var lastWhitespace = insideTagText.LastIndexOfAny([' ', '\n', '\r', '\t']);
                var partialAttr = lastWhitespace >= 0 ? insideTagText[(lastWhitespace + 1)..] : string.Empty;

                _tokenStartIndex = lastOpenBracket + 1 + (lastWhitespace + 1);
                _tokenEndIndex = _caretIndex;
                _activeContextLabel = $"<{currentTag}> Parameters";

                if (_attributeSuggestionsByTag.TryGetValue(currentTag, out var tagAttrs))
                {
                    _suggestions = tagAttrs
                        .Where(a => a.DisplayLabel.StartsWith(partialAttr, StringComparison.OrdinalIgnoreCase))
                        .ToList();
                    if (_suggestions.Count > 0)
                        return;
                }

                _suggestions =
                [
                    new("Modifier=\"@(UIModifier.New...)\"", "Modifier=\"@(UIModifier.New.FillMaxWidth().Padding(16))\"", "Attach a UIModifier chain", -2),
                    new("Gap=\"0.75rem\"", "Gap=\"0.75rem\"", "Spacing between child items", -1)
                ];
                return;
            }
        }

        _tokenStartIndex = _caretIndex;
        _tokenEndIndex = _caretIndex;
        _activeContextLabel = "Insert Component";
        _suggestions = _componentSuggestions.Take(10).ToList();
    }

    private void ParseMarkupAndExplain()
    {
        _parseWarning = null;
        _liveExplanations.Clear();

        try
        {
            _parsedRootNodes = ParseNodes(_markupCode);
            foreach (var node in FlattenNodes(_parsedRootNodes))
            {
                _liveExplanations.Add(DescribeNode(node));
            }
        }
        catch (Exception ex)
        {
            _parseWarning = $"Markup syntax note: {ex.Message}";
        }
    }

    private static IEnumerable<ParsedUiNode> FlattenNodes(IEnumerable<ParsedUiNode> nodes)
    {
        foreach (var node in nodes)
        {
            yield return node;
            foreach (var child in FlattenNodes(node.Children))
                yield return child;
        }
    }

    private static NodeExplanation DescribeNode(ParsedUiNode node)
    {
        var modText = node.Attributes.TryGetValue("Modifier", out var rawMod) ? $" with {rawMod}" : " (using default theme tokens)";
        return node.TagName switch
        {
            "TitledWindow" => new("<TitledWindow>", $"Routes outer sizing/borders to Frame and Padding/Gap to inner Body{modText}."),
            "Window" => new("<Window>", $"Scoped surface container (--_w-bg, --_w-padding) with zero CSS bleed{modText}."),
            "ActionButton" => new("<ActionButton>", $"Auto-adaptive 3D/Touch button{modText}."),
            "TextInput" => new("<TextInput>", $"Form input wrapped in Window with TouchInputMode support{modText}."),
            "NumberInput" => new("<NumberInput>", $"Generic INumber<T> stepper with auto-repeat buttons & TouchNumpad sheet."),
            "RangeSlider" or "RadioSlider" => new($"<{node.TagName}>", $"Pointer-captured slider inheriting SliderBase."),
            _ => new($"<{node.TagName}>", $"Composed layout/UI element{modText}.")
        };
    }

    private static List<ParsedUiNode> ParseNodes(string markup)
    {
        var rootNodes = new List<ParsedUiNode>();
        var stack = new Stack<ParsedUiNode>();
        var tagRegex = new Regex(@"<(/?)([A-Za-z0-9]+)([^>]*?)(/?)>", RegexOptions.Singleline);

        foreach (Match match in tagRegex.Matches(markup))
        {
            bool isClosing = match.Groups[1].Value == "/";
            string tagName = match.Groups[2].Value;
            string attrChunk = match.Groups[3].Value;
            bool isSelfClosing = match.Groups[4].Value == "/" ||
                                 tagName is "Divider" or "Spacer" or "ActionButton" or "TextInput" or "NumberInput"
                                     or "Checkbox" or "SegmentedControl" or "Dropdown" or "RangeSlider" or "RadioSlider"
                                     or "Pill" or "Text" or "SimpleSpinner" or "Mars" or "TouchNumpad" or "ScreenKeyboard"
                                     or "ProgressBar" or "CountdownTimer";

            if (isClosing)
            {
                if (stack.Count > 0 && string.Equals(stack.Peek().TagName, tagName, StringComparison.OrdinalIgnoreCase))
                    stack.Pop();
                continue;
            }

            var node = new ParsedUiNode
            {
                TagName = tagName,
                Attributes = ParseAttributes(attrChunk)
            };

            if (stack.Count > 0)
                stack.Peek().Children.Add(node);
            else
                rootNodes.Add(node);

            if (!isSelfClosing)
                stack.Push(node);
        }

        return rootNodes;
    }

    private static Dictionary<string, string> ParseAttributes(string rawAttributes)
    {
        var result = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        var attrRegex = new Regex(@"([A-Za-z0-9\-]+)\s*=\s*""(@\([^""]*\)|[^""]*)""");

        foreach (Match m in attrRegex.Matches(rawAttributes))
        {
            result[m.Groups[1].Value] = m.Groups[2].Value;
        }

        var modMatch = Regex.Match(rawAttributes, @"Modifier\s*=\s*""@?\((UIModifier\.New.*?)\)\""");
        if (modMatch.Success)
            result["Modifier"] = modMatch.Groups[1].Value;

        return result;
    }

    private static UIModifier ParseModifierChain(string? rawModifier)
    {
        var modifier = UIModifier.New;
        if (string.IsNullOrWhiteSpace(rawModifier))
            return modifier;

        var callRegex = new Regex(@"\.([A-Za-z0-9]+)\(([^)]*)\)");
        foreach (Match call in callRegex.Matches(rawModifier))
        {
            var method = call.Groups[1].Value;
            var args = call.Groups[2].Value
                .Split(',', StringSplitOptions.RemoveEmptyEntries)
                .Select(a => a.Trim().Trim('"'))
                .ToArray();

            switch (method)
            {
                case "FillMaxWidth": modifier.FillMaxWidth(); break;
                case "FillMaxHeight": modifier.FillMaxHeight(); break;
                case "FillMaxSize": modifier.FillMaxSize(); break;
                case "CenterContent": modifier.CenterContent(); break;
                case "Row": modifier.Row(); break;
                case "Column": modifier.Column(); break;
                case "Wrap": modifier.Wrap(); break;
                case "Width" when args.Length == 1:
                    if (double.TryParse(args[0], CultureInfo.InvariantCulture, out var w)) modifier.Width(w);
                    else modifier.Width(args[0]);
                    break;
                case "Height" when args.Length == 1:
                    if (double.TryParse(args[0], CultureInfo.InvariantCulture, out var h)) modifier.Height(h);
                    else modifier.Height(args[0]);
                    break;
                case "Padding" when args.Length == 1:
                    if (double.TryParse(args[0], CultureInfo.InvariantCulture, out var p)) modifier.Padding(p);
                    else modifier.Padding(args[0]);
                    break;
                case "Padding" when args.Length == 2:
                    if (double.TryParse(args[0], CultureInfo.InvariantCulture, out var pv) &&
                        double.TryParse(args[1], CultureInfo.InvariantCulture, out var ph))
                        modifier.Padding(pv, ph);
                    break;
                case "Gap" when args.Length == 1:
                    if (double.TryParse(args[0], CultureInfo.InvariantCulture, out var g)) modifier.Gap(g);
                    else modifier.Gap(args[0]);
                    break;
                case "Background" when args.Length == 1: modifier.Background(args[0]); break;
                case "HeaderBackground" when args.Length == 1: modifier.HeaderBackground(args[0]); break;
                case "BorderColor" when args.Length == 1: modifier.BorderColor(args[0]); break;
                case "BorderRadius" when args.Length == 1:
                    if (double.TryParse(args[0], CultureInfo.InvariantCulture, out var r)) modifier.BorderRadius(r);
                    else modifier.BorderRadius(args[0]);
                    break;
                case "BaseColor" when args.Length == 1: modifier.BaseColor(args[0]); break;
                case "TextColor" when args.Length == 1: modifier.TextColor(args[0]); break;
                case "AccentColor" when args.Length == 1: modifier.AccentColor(args[0]); break;
                case "ButtonExtrusionDepth" or "Depth" when args.Length == 1:
                    if (double.TryParse(args[0], CultureInfo.InvariantCulture, out var d)) modifier.ButtonExtrusionDepth(d);
                    break;
                case "InwardPressScaleFactor" or "PressScale" when args.Length == 1:
                    if (double.TryParse(args[0], CultureInfo.InvariantCulture, out var s)) modifier.InwardPressScaleFactor(s);
                    break;
                case "PressAnimationDuration" or "AnimationSpeed" when args.Length == 1:
                    modifier.PressAnimationDuration(args[0]);
                    break;
                case "StrokeThickness" or "Thickness" when args.Length == 1:
                    if (double.TryParse(args[0], CultureInfo.InvariantCulture, out var t)) modifier.StrokeThickness(t);
                    else modifier.StrokeThickness(args[0]);
                    break;
            }
        }

        return modifier;
    }

    private RenderFragment RenderParsedTree(List<ParsedUiNode> nodes) => __builder =>
    {
        <Column Gap="1rem" Modifier="@(UIModifier.New.FillMaxWidth())">
            @foreach (var (node, index) in nodes.Select((n, i) => (n, i)))
            {
                @RenderSingleNode(node, $"root_{index}")
            }
        </Column>
    };

    private RenderFragment RenderSingleNode(ParsedUiNode node, string stateKey) => __builder =>
    {
        var modifier = ParseModifierChain(node.Attributes.GetValueOrDefault("Modifier"));

        switch (node.TagName)
        {
            case "TitledWindow":
                <TitledWindow Title="@node.Attributes.GetValueOrDefault("Title", "TitledWindow")"
                              Modifier="@modifier">
                    @foreach (var (child, idx) in node.Children.Select((c, i) => (c, i)))
                    {
                        @RenderSingleNode(child, $"{stateKey}_{idx}")
                    }
                </TitledWindow>
                break;

            case "Window":
                <Window Modifier="@modifier">
                    @foreach (var (child, idx) in node.Children.Select((c, i) => (c, i)))
                    {
                        @RenderSingleNode(child, $"{stateKey}_{idx}")
                    }
                </Window>
                break;

            case "Row":
                var rowArr = Enum.TryParse<Arrangement>(node.Attributes.GetValueOrDefault("HorizontalArrangement"), true, out var parsedArr)
                    ? parsedArr : Arrangement.Start;
                <Row Gap="@node.Attributes.GetValueOrDefault("Gap", "0.65rem")"
                     HorizontalArrangement="@rowArr"
                     Wrap="true"
                     Modifier="@modifier">
                    @foreach (var (child, idx) in node.Children.Select((c, i) => (c, i)))
                    {
                        @RenderSingleNode(child, $"{stateKey}_{idx}")
                    }
                </Row>
                break;

            case "Column":
                <Column Gap="@node.Attributes.GetValueOrDefault("Gap", "0.65rem")"
                        Modifier="@modifier">
                    @foreach (var (child, idx) in node.Children.Select((c, i) => (c, i)))
                    {
                        @RenderSingleNode(child, $"{stateKey}_{idx}")
                    }
                </Column>
                break;

            case "Grid":
                <Grid MinColumnWidth="@node.Attributes.GetValueOrDefault("MinColumnWidth", "200px")"
                      Gap="@node.Attributes.GetValueOrDefault("Gap", "1rem")"
                      Modifier="@modifier">
                    @foreach (var (child, idx) in node.Children.Select((c, i) => (c, i)))
                    {
                        @RenderSingleNode(child, $"{stateKey}_{idx}")
                    }
                </Grid>
                break;

            case "ActionButton":
                var variant = Enum.TryParse<ActionButton.ButtonVariant>(node.Attributes.GetValueOrDefault("Variant"), true, out var bv)
                    ? bv : ActionButton.ButtonVariant.Solid;
                var shape = Enum.TryParse<ActionButton.ButtonShape>(node.Attributes.GetValueOrDefault("Shape"), true, out var bs)
                    ? bs : ActionButton.ButtonShape.Rounded;
                var size = Enum.TryParse<ActionButton.ButtonSize>(node.Attributes.GetValueOrDefault("Size"), true, out var bsz)
                    ? bsz : ActionButton.ButtonSize.Dynamic;
                var holdMs = int.TryParse(node.Attributes.GetValueOrDefault("HoldToConfirmDurationMilliseconds"), out var hms) ? hms : 0;
                var label = node.Attributes.GetValueOrDefault("Text", "ActionButton");

                <ActionButton Variant="@variant"
                              Shape="@shape"
                              Size="@size"
                              HoldToConfirmDurationMilliseconds="@holdMs"
                              AutoRepeat="@(string.Equals(node.Attributes.GetValueOrDefault("AutoRepeat"), "true", StringComparison.OrdinalIgnoreCase))"
                              IsLoading="@(string.Equals(node.Attributes.GetValueOrDefault("IsLoading"), "true", StringComparison.OrdinalIgnoreCase))"
                              Modifier="@modifier"
                              Text="@label"
                              OnClick="@(() => Toast.ShowSuccess($"Triggered <ActionButton Text=\"{label}\" />!"))" />
                break;

            case "TextInput":
                if (!_stringState.ContainsKey(stateKey))
                    _stringState[stateKey] = string.Empty;
                var touchMode = Enum.TryParse<TouchInputMode>(node.Attributes.GetValueOrDefault("TouchMode"), true, out var tm)
                    ? tm : TouchInputMode.Auto;
                <TextInput Label="@node.Attributes.GetValueOrDefault("Label")"
                           Placeholder="@node.Attributes.GetValueOrDefault("Placeholder", "Type here...")"
                           IsPassword="@(string.Equals(node.Attributes.GetValueOrDefault("IsPassword"), "true", StringComparison.OrdinalIgnoreCase))"
                           TouchMode="@touchMode"
                           Value="@_stringState[stateKey]"
                           ValueChanged="@(val => _stringState[stateKey] = val)"
                           Modifier="@modifier" />
                break;

            case "NumberInput":
                if (!_numberState.ContainsKey(stateKey))
                    _numberState[stateKey] = 1;
                var step = double.TryParse(node.Attributes.GetValueOrDefault("Step"), CultureInfo.InvariantCulture, out var st) ? st : 1;
                var min = double.TryParse(node.Attributes.GetValueOrDefault("Min"), CultureInfo.InvariantCulture, out var mn) ? mn : 0;
                var max = double.TryParse(node.Attributes.GetValueOrDefault("Max"), CultureInfo.InvariantCulture, out var mx) ? mx : 100;
                <NumberInput TValue="double"
                             Value="@_numberState[stateKey]"
                             ValueChanged="@(val => _numberState[stateKey] = val)"
                             Step="@step"
                             Min="@min"
                             Max="@max"
                             Suffix="@node.Attributes.GetValueOrDefault("Suffix")"
                             Modifier="@modifier" />
                break;

            case "Checkbox":
                if (!_boolState.ContainsKey(stateKey))
                    _boolState[stateKey] = true;
                <Checkbox Checked="@_boolState[stateKey]"
                          CheckedChanged="@(val => _boolState[stateKey] = val)"
                          RenderAsToggleSwitch="@(string.Equals(node.Attributes.GetValueOrDefault("RenderAsToggleSwitch"), "true", StringComparison.OrdinalIgnoreCase))"
                          Label="@node.Attributes.GetValueOrDefault("Label", "Checkbox")"
                          Modifier="@modifier" />
                break;

            case "SegmentedControl":
                var items = (node.Attributes.GetValueOrDefault("Items", "Option 1,Option 2,Option 3"))
                    .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
                if (!_stringState.ContainsKey(stateKey) || string.IsNullOrEmpty(_stringState[stateKey]))
                    _stringState[stateKey] = items.FirstOrDefault() ?? "Option 1";
                <SegmentedControl TItem="string"
                                  Items="@items"
                                  Value="@_stringState[stateKey]"
                                  ValueChanged="@(val => _stringState[stateKey] = val)"
                                  Modifier="@modifier" />
                break;

            case "Dropdown":
                var ddItems = (node.Attributes.GetValueOrDefault("Items", "Item A,Item B,Item C"))
                    .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
                if (!_stringState.ContainsKey(stateKey) || string.IsNullOrEmpty(_stringState[stateKey]))
                    _stringState[stateKey] = ddItems.FirstOrDefault();
                <Dropdown TItem="string"
                          Items="@ddItems"
                          Value="@_stringState[stateKey]"
                          ValueChanged="@(val => _stringState[stateKey] = val)"
                          Modifier="@modifier" />
                break;

            case "RangeSlider":
                if (!_numberState.ContainsKey(stateKey))
                    _numberState[stateKey] = 50;
                var trackW = double.TryParse(node.Attributes.GetValueOrDefault("TrackWidthPx"), CultureInfo.InvariantCulture, out var tw) ? tw : 240;
                var rsMin = double.TryParse(node.Attributes.GetValueOrDefault("MinValue"), CultureInfo.InvariantCulture, out var rmn) ? rmn : 0;
                var rsMax = double.TryParse(node.Attributes.GetValueOrDefault("MaxValue"), CultureInfo.InvariantCulture, out var rmx) ? rmx : 100;
                var rsStep = double.TryParse(node.Attributes.GetValueOrDefault("Step"), CultureInfo.InvariantCulture, out var rst) ? rst : 10;
                <RangeSlider TrackWidthPx="@trackW"
                             MinValue="@rsMin"
                             MaxValue="@rsMax"
                             Step="@rsStep"
                             SelectionUnit="@node.Attributes.GetValueOrDefault("SelectionUnit", "%")"
                             SelectedValue="@_numberState[stateKey]"
                             SelectedValueChanged="@(val => _numberState[stateKey] = val)" />
                break;

            case "RadioSlider":
                if (!_numberState.ContainsKey(stateKey))
                    _numberState[stateKey] = 22;
                var dialSz = double.TryParse(node.Attributes.GetValueOrDefault("DialSizePx"), CultureInfo.InvariantCulture, out var dsz) ? dsz : 180;
                var maxAng = int.TryParse(node.Attributes.GetValueOrDefault("MaxAngle"), out var mang) ? mang : 240;
                var rdMin = double.TryParse(node.Attributes.GetValueOrDefault("MinValue"), CultureInfo.InvariantCulture, out var dmn) ? dmn : 0;
                var rdMax = double.TryParse(node.Attributes.GetValueOrDefault("MaxValue"), CultureInfo.InvariantCulture, out var dmx) ? dmx : 100;
                var rdStep = double.TryParse(node.Attributes.GetValueOrDefault("Step"), CultureInfo.InvariantCulture, out var dst) ? dst : 5;
                <RadioSlider DialSizePx="@dialSz"
                             MaxAngle="@maxAng"
                             MinValue="@rdMin"
                             MaxValue="@rdMax"
                             Step="@rdStep"
                             SelectionUnit="@node.Attributes.GetValueOrDefault("SelectionUnit", "%")"
                             SelectedValue="@_numberState[stateKey]"
                             SelectedValueChanged="@(val => _numberState[stateKey] = val)" />
                break;

            case "Pill":
                var pillVar = Enum.TryParse<Pill.PillVariant>(node.Attributes.GetValueOrDefault("Variant"), true, out var pv)
                    ? pv : Pill.PillVariant.Neutral;
                <Pill Variant="@pillVar"
                      Text="@node.Attributes.GetValueOrDefault("Text", "Pill")"
                      Modifier="@modifier" />
                break;

            case "Text":
                var textVar = Enum.TryParse<TypographyVariant>(node.Attributes.GetValueOrDefault("Variant"), true, out var tv)
                    ? tv : TypographyVariant.Body;
                FontWeight? weight = Enum.TryParse<FontWeight>(node.Attributes.GetValueOrDefault("Weight"), true, out var fw)
                    ? fw : null;
                <ALKsPersonalUI.Layout.Text Variant="@textVar"
                                            Weight="@weight"
                                            Muted="@(string.Equals(node.Attributes.GetValueOrDefault("Muted"), "true", StringComparison.OrdinalIgnoreCase))"
                                            Value="@node.Attributes.GetValueOrDefault("Value", "Text")"
                                            Modifier="@modifier" />
                break;

            case "Divider":
                <Divider Vertical="@(string.Equals(node.Attributes.GetValueOrDefault("Vertical"), "true", StringComparison.OrdinalIgnoreCase))"
                         Color="@node.Attributes.GetValueOrDefault("Color")"
                         Thickness="@node.Attributes.GetValueOrDefault("Thickness")" />
                break;

            case "Spacer":
                <Spacer Modifier="@modifier" />
                break;

            case "SimpleSpinner":
                <SimpleSpinner Modifier="@modifier" />
                break;

            case "OrbitalLoader":
                var sysSize = int.TryParse(node.Attributes.GetValueOrDefault("SystemSize"), out var ssz) ? ssz : 100;
                var satCnt = int.TryParse(node.Attributes.GetValueOrDefault("SatelliteCount"), out var sc) ? sc : 8;
                <OrbitalLoader SystemSize="@sysSize"
                               SatelliteCount="@satCnt"
                               LoadingText="@node.Attributes.GetValueOrDefault("LoadingText", "Loading...")">
                    <Mars PlanetSize="44" />
                </OrbitalLoader>
                break;

            case "ProgressBar":
                var pbVal = double.TryParse(node.Attributes.GetValueOrDefault("Value"), CultureInfo.InvariantCulture, out var pvNum) ? pvNum : 50;
                var pbMax = double.TryParse(node.Attributes.GetValueOrDefault("Max"), CultureInfo.InvariantCulture, out var pmNum) ? pmNum : 100;
                <ProgressBar Value="@pbVal"
                             Max="@pbMax"
                             Label="@node.Attributes.GetValueOrDefault("Label")"
                             ShowPercentage="@(!string.Equals(node.Attributes.GetValueOrDefault("ShowPercentage"), "false", StringComparison.OrdinalIgnoreCase))"
                             Modifier="@modifier" />
                break;

            case "CountdownTimer":
                var totalSec = int.TryParse(node.Attributes.GetValueOrDefault("TotalSeconds"), out var ts) ? ts : 30;
                <CountdownTimer TotalSeconds="@totalSec"
                                AutoStart="@(!string.Equals(node.Attributes.GetValueOrDefault("AutoStart"), "false", StringComparison.OrdinalIgnoreCase))"
                                Modifier="@modifier" />
                break;

            case "AspectRatioFrame":
                var aspectW = int.TryParse(node.Attributes.GetValueOrDefault("AspectWidth"), out var aw) ? aw : 16;
                var aspectH = int.TryParse(node.Attributes.GetValueOrDefault("AspectHeight"), out var ah) ? ah : 9;
                <AspectRatioFrame AspectWidth="@aspectW"
                                  AspectHeight="@aspectH"
                                  Modifier="@modifier">
                    @RenderParsedTree(node.Children)
                </AspectRatioFrame>
                break;

            case "KioskShell":
                var idleSec = int.TryParse(node.Attributes.GetValueOrDefault("IdleTimeoutSeconds"), out var ids) ? ids : 30;
                <KioskShell IsPreview="@(!string.Equals(node.Attributes.GetValueOrDefault("IsPreview"), "false", StringComparison.OrdinalIgnoreCase))"
                            IdleTimeoutSeconds="@idleSec"
                            Modifier="@modifier">
                    @RenderParsedTree(node.Children)
                </KioskShell>
                break;

            case "TemplateSlot":
                var isEditor = !bool.TryParse(node.Attributes.GetValueOrDefault("IsEditorMode"), out var ed) || ed;
                var isFilled = bool.TryParse(node.Attributes.GetValueOrDefault("IsFilled"), out var fl) && fl;
                <TemplateSlot SlotName="@node.Attributes.GetValueOrDefault("SlotName", "Slot")"
                              PlaceholderText="@node.Attributes.GetValueOrDefault("PlaceholderText", "Drop or select content")"
                              IsEditorMode="@isEditor"
                              IsFilled="@isFilled"
                              Modifier="@modifier">
                    @RenderParsedTree(node.Children)
                </TemplateSlot>
                break;

            case "FrameBox":
                <FrameBox BorderColor="@node.Attributes.GetValueOrDefault("BorderColor")"
                          Padding="@node.Attributes.GetValueOrDefault("Padding")"
                          Modifier="@modifier">
                    @RenderParsedTree(node.Children)
                </FrameBox>
                break;
        }
    };
}