@page "/json-showcase"
@using System.Globalization
@implements IAsyncDisposable

<Column Gap="1.5rem" Modifier="@(UIModifier.New.FillMaxWidth().MaxWidth(1100))">
    <TitledWindow Title="JSON-Driven Full Showcase (/json-showcase)" Modifier="@ShowcaseStyles.SectionWindow">
        <Column Gap="1rem">
            <ALKsPersonalUI.Layout.Text Variant="TypographyVariant.Body">
                Every component below is serialized to JSON, parsed back into a <code>JsonUiNode</code> tree, and rendered dynamically.
            </ALKsPersonalUI.Layout.Text>

            <Row Gap="0.75rem" Wrap="true">
                <ActionButton Text="Interactive Quiz Runtime (JsonUiDocument)"
                              Variant="@(_isDocumentMode ? ActionButton.ButtonVariant.Solid : ActionButton.ButtonVariant.Outline)"
                              OnClick="@(() => _isDocumentMode = true)" />
                <ActionButton Text="Static Node Tree (JsonUiNode)"
                              Variant="@(!_isDocumentMode ? ActionButton.ButtonVariant.Solid : ActionButton.ButtonVariant.Outline)"
                              OnClick="@(() => _isDocumentMode = false)" />
                <ActionButton Text="Re-parse &amp; Render JSON"
                              Variant="ActionButton.ButtonVariant.Ghost"
                              OnClick="ParseJson" />
                <ActionButton Text="@(_showJsonEditor ? "Hide JSON" : "Show / Edit JSON")"
                              Variant="ActionButton.ButtonVariant.Ghost"
                              OnClick="@(() => _showJsonEditor = !_showJsonEditor)" />
                @if (_isDocumentMode)
                {
                    <ActionButton Text="@(_isOffline ? "Simulate Online" : "Simulate Offline")"
                                  Variant="ActionButton.ButtonVariant.Outline"
                                  OnClick="@(() => _isOffline = !_isOffline)" />
                }
                @if (!string.IsNullOrWhiteSpace(_lastActionMessage))
                {
                    <Pill Text="@_lastActionMessage" Active="true" />
                }
            </Row>

            @if (!string.IsNullOrWhiteSpace(_parseError))
            {
                <ALKsPersonalUI.Layout.Text Variant="TypographyVariant.Caption" Color="var(--ui-danger)">@_parseError</ALKsPersonalUI.Layout.Text>
            }

            @if (_showJsonEditor)
            {
                <TextArea Label="Showcase JSON Tree"
                          Rows="10"
                          MaxLength="50000"
                          @bind-Value="_jsonPayload" />
            }
        </Column>
    </TitledWindow>

    @if (_isDocumentMode)
    {
        <JsonUiRenderer @ref="_jsonRenderer"
                        Json="@_quizDocumentJson"
                        IsOffline="@_isOffline"
                        DataSources="@_leaderboardDataSources"
                        OnHostCommand="HandleHostCommand" />
    }
    else if (_parsedRoot is not null)
    {
        <JsonUiRenderer Node="@_parsedRoot" OnAction="HandleNodeAction" />
    }
</Column>

@code {
    private const int ProgressTickMilliseconds = 500;
    private const int ProgressStep = 4;
    private const int MaxProgress = 100;

    private string? _jsonPayload;
    private string? _parseError;
    private string? _lastActionMessage;
    private JsonUiNode? _parsedRoot;
    private bool _showJsonEditor;
    private bool _isDocumentMode = true;
    private bool _isOffline;
    private JsonUiRenderer? _jsonRenderer;
    private readonly List<IReadOnlyDictionary<string, object?>> _leaderboardRows =
    [
        new Dictionary<string, object?> { ["name"] = "Ada", ["score"] = 20, ["elapsed"] = "12s" },
        new Dictionary<string, object?> { ["name"] = "Linus", ["score"] = 10, ["elapsed"] = "18s" }
    ];
    private IReadOnlyDictionary<string, IReadOnlyList<IReadOnlyDictionary<string, object?>>> _leaderboardDataSources =>
        new Dictionary<string, IReadOnlyList<IReadOnlyDictionary<string, object?>>>
        {
            ["scores"] = _leaderboardRows
        };
    private PeriodicTimer? _progressTimer;
    private CancellationTokenSource? _timerCts;
    private Task? _progressLoopTask;

    protected override void OnInitialized()
    {
        _jsonPayload = BuildFullShowcaseTree().ToJson(indented: true);
        ParseJson();
        StartProgressTimer();
    }

    private void HandleNodeAction(string actionName)
    {
        _lastActionMessage = $"Triggered: {actionName}";
    }

    private async Task HandleHostCommand(JsonUiHostCommand command)
    {
        if (string.Equals(command.Command, "submitScore", StringComparison.Ordinal))
        {
            var rawPlayer = command.Payload.TryGetValue("playerName", out var p) && p is not null
                ? p.ToString()!.Trim()
                : "Guest";
            var player = string.IsNullOrWhiteSpace(rawPlayer) ? "Guest" : rawPlayer;
            var score = command.Payload.TryGetValue("score", out var s) && s is not null ? s : 0;
            var elapsed = command.Payload.TryGetValue("elapsedSeconds", out var e) && e is not null ? $"{e}s" : "0s";
            _leaderboardRows.Insert(0, new Dictionary<string, object?>
            {
                ["name"] = player,
                ["score"] = score,
                ["elapsed"] = elapsed
            });
            _lastActionMessage = $"HostCommand: submitScore ({player}: {score})";

            if (_jsonRenderer is not null)
            {
                await _jsonRenderer.SetStateValueAsync("playerName", player);
            }
        }
    }

