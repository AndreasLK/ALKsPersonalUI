@page "/templates"
@using ALKsPersonalUI.Templates

<PageTitle>Kiosk &amp; Templates — ALKsPersonalUI</PageTitle>

<Column Modifier="@(UIModifier.New.FillMaxWidth())" Gap="2rem">
    <TitledWindow Title="AspectRatioFrame" Modifier="@ShowcaseStyles.SectionWindow">
        <Column Gap="1rem">
            <Text Variant="TypographyVariant.Body">
                Constrains child content to a fixed aspect ratio (default 16:9) for kiosk displays and media.
            </Text>
            <Box Modifier="@(UIModifier.New.MaxWidth(480).FillMaxWidth())">
                <AspectRatioFrame AspectWidth="16" AspectHeight="9">
                    <Box Modifier="@(UIModifier.New.FillMaxWidth().FillMaxHeight().Background("var(--ui-bg-elevated)").Border("1px solid var(--ui-border)").Padding(16))">
                        <Column AlignItems="HorizontalAlignment.Center" JustifyContent="Arrangement.Center" Modifier="@(UIModifier.New.FillMaxHeight())">
                            <Text Variant="TypographyVariant.Title">16:9 Frame</Text>
                            <Text Variant="TypographyVariant.Caption" Color="var(--ui-text-muted)">Responsive aspect-locked container</Text>
                        </Column>
                    </Box>
                </AspectRatioFrame>
            </Box>
        </Column>
    </TitledWindow>

    <TitledWindow Title="KioskShell (Preview Mode)" Modifier="@ShowcaseStyles.SectionWindow">
        <Column Gap="1rem">
            <Text Variant="TypographyVariant.Body">
                Full-bleed kiosk container with optional idle-timeout monitoring. Shown in preview mode below.
            </Text>
            <KioskShell IsPreview="true" IdleTimeoutSeconds="30">
                <Column Padding="1.5rem" Gap="0.75rem" AlignItems="HorizontalAlignment.Center">
                    <Pill Text="Kiosk Preview" Variant="Pill.PillVariant.Accent" />
                    <Text Variant="TypographyVariant.Title">Welcome to the Interactive Kiosk</Text>
                    <Text Variant="TypographyVariant.Body" Color="var(--ui-text-muted)">
                        Tap anywhere to begin your session.
                    </Text>
                </Column>
            </KioskShell>
        </Column>
    </TitledWindow>

    <TitledWindow Title="QuizTemplate" Modifier="@ShowcaseStyles.SectionWindow">
        <Column Gap="1rem">
            <Text Variant="TypographyVariant.Body">
                Structured quiz layout with progress header, question prompt, and answer slots.
            </Text>
            <QuizTemplate CurrentQuestionNumber="@_quizQuestion"
                          TotalQuestions="5"
                          QuestionText="Which Blazor feature powers ALKsPersonalUI without JavaScript?"
                          Score="@_quizScore">
                <Column Gap="0.75rem">
                    <ActionButton Text="Pure C# &amp; CSS" Variant="ActionButton.ButtonVariant.Outline" OnClick="@(() => AnswerQuiz(true))" />
                    <ActionButton Text="jQuery Plugins" Variant="ActionButton.ButtonVariant.Outline" OnClick="@(() => AnswerQuiz(false))" />
                </Column>
            </QuizTemplate>
        </Column>
    </TitledWindow>

    <TitledWindow Title="GameTemplate" Modifier="@ShowcaseStyles.SectionWindow">
        <Column Gap="1rem">
            <Text Variant="TypographyVariant.Body">
                Arcade/game HUD shell with score, lives, and central stage.
            </Text>
            <GameTemplate Title="Space Dodge" Score="@_gameScore" Lives="3">
                <Column Padding="1.5rem" Gap="1rem" AlignItems="HorizontalAlignment.Center">
                    <Text Variant="TypographyVariant.Body">Game Stage Content</Text>
                    <ActionButton Text="+100 Points" Variant="ActionButton.ButtonVariant.Solid" OnClick="@(() => _gameScore += 100)" />
                </Column>
            </GameTemplate>
        </Column>
    </TitledWindow>
</Column>

@code {
    private int _quizQuestion = 1;
    private int _quizScore;
    private int _gameScore = 250;

    private void AnswerQuiz(bool isCorrect)
    {
        if (isCorrect)
            _quizScore += 10;

        _quizQuestion = _quizQuestion < 5 ? _quizQuestion + 1 : 1;
    }
}
