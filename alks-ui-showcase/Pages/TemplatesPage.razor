@page "/templates"
@using ALKsPersonalUI.Templates

<PageTitle>Kiosk &amp; Templates — ALKsPersonalUI</PageTitle>

<Column Modifier="@(UIModifier.New.FillMaxWidth())" Gap="2rem">
    <TitledWindow Title="AspectRatioFrame" Modifier="@ShowcaseStyles.SectionWindow">
        <Column Gap="1rem">
            <Text Variant="TypographyVariant.Body">
                Constrains child content to a fixed aspect ratio (default 16:9) for kiosk displays and media.
            </Text>
            <Box Modifier="@(UIModifier.New.MaxWidth(480).FillMaxWidth())">
                <AspectRatioFrame AspectWidth="16" AspectHeight="9">
                    <Box Modifier="@(UIModifier.New.FillMaxWidth().FillMaxHeight().Background("var(--ui-bg-elevated)").Border("1px solid var(--ui-border)").Padding(16))">
                        <Column AlignItems="HorizontalAlignment.Center" JustifyContent="Arrangement.Center" Modifier="@(UIModifier.New.FillMaxHeight())">
                            <Text Variant="TypographyVariant.Title">16:9 Frame</Text>
                            <Text Variant="TypographyVariant.Caption" Color="var(--ui-text-muted)">Responsive aspect-locked container</Text>
                        </Column>
                    </Box>
                </AspectRatioFrame>
            </Box>
        </Column>
    </TitledWindow>

    <TitledWindow Title="KioskShell (Preview Mode)" Modifier="@ShowcaseStyles.SectionWindow">
        <Column Gap="1rem">
            <Text Variant="TypographyVariant.Body">
                Full-bleed kiosk container with optional idle-timeout monitoring. Shown in preview mode below.
            </Text>
            <KioskShell IsPreview="true" IdleTimeoutSeconds="30">
                <Column Padding="1.5rem" Gap="0.75rem" AlignItems="HorizontalAlignment.Center">
                    <Pill Text="Kiosk Preview" Variant="Pill.PillVariant.Accent" />
                    @if (!_kioskStarted)
                    {
                        <ALKsPersonalUI.Layout.Text Variant="TypographyVariant.Title">Welcome to the Interactive Kiosk</ALKsPersonalUI.Layout.Text>
                        <ALKsPersonalUI.Layout.Text Variant="TypographyVariant.Body" Color="var(--ui-text-muted)">
                            Select a service below to begin your session.
                        </ALKsPersonalUI.Layout.Text>
                        <ActionButton Text="Start Session" Variant="ActionButton.ButtonVariant.Solid" OnClick="@(() => _kioskStarted = true)" />
                    }
                    else
                    {
                        <ALKsPersonalUI.Layout.Text Variant="TypographyVariant.Title">Check-In &amp; Tickets</ALKsPersonalUI.Layout.Text>
                        <Row Gap="0.75rem" Wrap="true" JustifyContent="Arrangement.Center">
                            <ActionButton Text="Express Check-In" Variant="ActionButton.ButtonVariant.Outline" OnClick="@(() => _kioskSelection = "Express Check-In selected")" />
                            <ActionButton Text="Print Pass" Variant="ActionButton.ButtonVariant.Outline" OnClick="@(() => _kioskSelection = "Pass queued for printing")" />
                            <ActionButton Text="End Session" Variant="ActionButton.ButtonVariant.Outline" OnClick="ResetKiosk" />
                        </Row>
                        @if (!string.IsNullOrEmpty(_kioskSelection))
                        {
                            <ALKsPersonalUI.Layout.Text Variant="TypographyVariant.Caption" Color="var(--ui-accent)">@_kioskSelection</ALKsPersonalUI.Layout.Text>
                        }
                    }
                </Column>
            </KioskShell>
        </Column>
    </TitledWindow>

    <TitledWindow Title="TemplateSlot &amp; FrameBox" Modifier="@ShowcaseStyles.SectionWindow">
        <Column Gap="1rem">
            <Text Variant="TypographyVariant.Body">
                Generic data-driven template primitives for the Content Service editor and screen renderer.
            </Text>
            <Row Gap="0.75rem" AlignItems="VerticalAlignment.Center">
                <ActionButton Text="@(_slotEditorMode ? "Switch to Screen Mode" : "Switch to Editor Mode")"
                              Variant="ActionButton.ButtonVariant.Outline"
                              OnClick="@(() => _slotEditorMode = !_slotEditorMode)" />
                <Text Variant="TypographyVariant.Caption" Color="var(--ui-text-muted)">
                    Last selected slot: @(_selectedSlotName ?? "None")
                </Text>
            </Row>
            <FrameBox BorderColor="var(--ui-accent)" Padding="1.25rem">
                <Column Gap="0.75rem">
                    <TemplateSlot SlotName="Header"
                                  IsEditorMode="@_slotEditorMode"
                                  IsFilled="true"
                                  OnSelectSlot="@(name => _selectedSlotName = name)">
                        <Text Variant="TypographyVariant.Title">Exhibition Title</Text>
                    </TemplateSlot>
                    <TemplateSlot SlotName="Media"
                                  PlaceholderText="Select an image or album"
                                  IsEditorMode="@_slotEditorMode"
                                  IsFilled="false"
                                  OnSelectSlot="@(name => _selectedSlotName = name)" />
                </Column>
            </FrameBox>
        </Column>
    </TitledWindow>
</Column>

@code {
    private bool _slotEditorMode = true;
    private string? _selectedSlotName;

    private bool _kioskStarted;
    private string? _kioskSelection;

    private void ResetKiosk()
    {
        _kioskStarted = false;
        _kioskSelection = null;
    }
}
