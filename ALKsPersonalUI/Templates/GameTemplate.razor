@inherits UIComponentBase

<div class="@BuildCssClasses()"
     style="@ModifierStyle"
     @attributes="AdditionalAttributes">
    @if (HudContent is not null)
    {
        <header class="ui-game-hud">
            @HudContent
        </header>
    }

    <div class="ui-game-stage">
        @if (StageContent is not null)
        {
            @StageContent
        }
        else if (ChildContent is not null)
        {
            @ChildContent
        }

        @if (OverlayContent is not null)
        {
            <div class="ui-game-overlay">
                @OverlayContent
            </div>
        }
    </div>

    @if (ControlsContent is not null)
    {
        <footer class="ui-game-controls">
            @ControlsContent
        </footer>
    }
</div>

@code {
    [Parameter] public RenderFragment? HudContent { get; set; }
    [Parameter] public RenderFragment? StageContent { get; set; }
    [Parameter] public RenderFragment? ControlsContent { get; set; }
    [Parameter] public RenderFragment? OverlayContent { get; set; }
    [Parameter] public bool IsPreview { get; set; }

    private string BuildCssClasses() => new CssBuilder()
        .Add("ui-game-template")
        .Add("preview", when: IsPreview)
        .AddRaw(ModifierClass)
        .Build();
}
