@inherits WindowBase

<Window Modifier="@ModifierOrEmpty.ForTitledWindowFrame()"
        @attributes="AdditionalAttributes">
    <div class="title-bar" style="@ModifierOrEmpty.BuildTitleBarStyle()">
        <div class="title-spacer"></div>
        <span class="title-text">@Title</span>
        <div class="title-actions">@HeaderActions</div>
    </div>
    <div class="body-content" style="@ModifierOrEmpty.BuildTitledWindowBodyStyle()">
        @ChildContent
    </div>
</Window>

@code {
    [Parameter] public string Title { get; set; } = WindowDefaults.DefaultTitle;
    [Parameter] public RenderFragment? HeaderActions { get; set; }
}