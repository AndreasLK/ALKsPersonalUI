@using System.Globalization
@inherits UIComponentBase

@if (!IsLocked)
{
    return;
}

<div class="@BuildBannerCssClasses()"
     style="@ModifierStyle"
     role="status"
     aria-live="polite"
     @attributes="AdditionalAttributes">
    <div class="lock-banner-info">
        <span class="lock-banner-title">
            @string.Format(CultureInfo.CurrentCulture, LockedByFormat, string.IsNullOrWhiteSpace(LockedByUser) ? UnknownEditorText : LockedByUser)
        </span>
        @if (LockedAt.HasValue)
        {
            <span class="lock-banner-time">
                @string.Format(CultureInfo.CurrentCulture, LockedSinceFormat, LockedAt.Value.ToLocalTime().ToString("g"))
            </span>
        }
    </div>

    <div class="lock-banner-actions">
        @if (OnRequestUnlock.HasDelegate)
        {
            <ActionButton Variant="ActionButton.ButtonVariant.Ghost"
                          OnClick="OnRequestUnlock">
                @RequestUnlockText
            </ActionButton>
        }
        @if (OnReleaseLock.HasDelegate)
        {
            <ActionButton OnClick="OnReleaseLock">
                @ReleaseLockText
            </ActionButton>
        }
    </div>
</div>

@code {
    [Parameter] public bool IsLocked { get; set; }
    [Parameter] public string? LockedByUser { get; set; }
    [Parameter] public DateTimeOffset? LockedAt { get; set; }
    /// <summary>Format string for the lock holder message. Receives the user name as {0}.</summary>
    [Parameter] public string LockedByFormat { get; set; } = "Locked by {0}";
    /// <summary>Fallback name shown when LockedByUser is empty.</summary>
    [Parameter] public string UnknownEditorText { get; set; } = "another editor";
    /// <summary>Format string for the lock timestamp. Receives the formatted local time as {0}.</summary>
    [Parameter] public string LockedSinceFormat { get; set; } = "since {0}";
    /// <summary>Label for the request unlock button.</summary>
    [Parameter] public string RequestUnlockText { get; set; } = "Request Unlock";
    /// <summary>Label for the release lock button.</summary>
    [Parameter] public string ReleaseLockText { get; set; } = "Release Lock";
    [Parameter] public EventCallback OnRequestUnlock { get; set; }
    [Parameter] public EventCallback OnReleaseLock { get; set; }

    private string BuildBannerCssClasses()
    {
        return new CssBuilder()
            .Add("lock-banner")
            .AddRaw(ModifierClass)
            .Build();
    }
}
