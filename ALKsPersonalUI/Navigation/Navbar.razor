@inherits UIComponentBase

<header class="@BuildWrapperCssClasses()" @attributes="AdditionalAttributes">
    <Window Modifier="@BuildNavbarWindowModifier()">
        <div class="navbar-inner">
            <a href="@BrandHref" class="navbar-brand" style="@BuildBrandStyles()">
                @if (HasCustomBrandContent)
                {
                    @BrandContent
                }
                else
                {
                    @if (ShouldRenderInlineBrandImage)
                    {
                        <img class="brand-image"
                             src="@BrandImageSource"
                             alt="@ResolvedBrandImageAlt"
                             draggable="false" />
                    }
                    @if (ShouldRenderBrandTitle)
                    {
                        <span class="brand-text">@Title</span>
                    }
                }
            </a>

            <nav class="navbar-links-desktop" aria-label="@NavigationAriaLabel">
                @NavItems
            </nav>

            <div class="navbar-right">
                @if (HasRightActions)
                {
                    <div class="navbar-actions">@RightActions</div>
                }
                @if (HasNavigationItems)
                {
                    <div class="navbar-burger-mobile">
                        <BurgerMenu Title="@Title"
                                    Modifier="@(UIModifier.Empty.AccentColor(ResolvedAccentColor))">
                            @NavItems
                        </BurgerMenu>
                    </div>
                }
            </div>
        </div>
    </Window>
</header>

@code {
    [Parameter] public string Title { get; set; } = NavigationDefaults.Navbar.DefaultTitle;
    /// <summary>Accessible label for the desktop navigation landmark.</summary>
    [Parameter] public string NavigationAriaLabel { get; set; } = "Main navigation";
    [Parameter] public string BrandHref { get; set; } = NavigationDefaults.Navbar.DefaultBrandHref;
    [Parameter] public string? BrandImageSource { get; set; }
    [Parameter] public string? BrandImageAlt { get; set; }
    [Parameter] public string? BrandImageSize { get; set; }
    [Parameter] public ImageFit BrandImageFit { get; set; } = ImageFit.Cover;
    [Parameter] public ImagePlacement BrandImagePlacement { get; set; } = ImagePlacement.Start;
    [Parameter] public RenderFragment? BrandContent { get; set; }
    [Parameter] public RenderFragment? NavItems { get; set; }
    [Parameter] public RenderFragment? RightActions { get; set; }

    private bool HasCustomBrandContent => BrandContent is not null;
    private bool HasBrandImage => !string.IsNullOrWhiteSpace(BrandImageSource);
    private bool ShouldRenderInlineBrandImage => HasBrandImage && BrandImagePlacement != ImagePlacement.Background;
    private bool ShouldRenderBrandTitle => !string.IsNullOrWhiteSpace(Title) && (!HasBrandImage || BrandImagePlacement != ImagePlacement.ReplaceText);
    private string ResolvedBrandImageAlt => BrandImageAlt ?? Title;
    private bool HasRightActions => RightActions is not null;
    private bool HasNavigationItems => NavItems is not null;

    private string BuildBrandStyles() => new StyleBuilder()
        .Add("--_nav-brand-dir", LayoutDefaults.ToFlexDirectionCss(BrandImagePlacement))
        .Add("--_nav-brand-img-size", BrandImageSize)
        .Add("--_nav-brand-img-fit", LayoutDefaults.ToCss(BrandImageFit))
        .AddIf(HasBrandImage && BrandImagePlacement == ImagePlacement.Background, "background-image", LayoutDefaults.FormatCssUrl(BrandImageSource))
        .AddIf(HasBrandImage && BrandImagePlacement == ImagePlacement.Background, "background-size", LayoutDefaults.ToCss(BrandImageFit))
        .AddIf(HasBrandImage && BrandImagePlacement == ImagePlacement.Background, "background-position", LayoutDefaults.Image.DefaultObjectPosition)
        .AddIf(HasBrandImage && BrandImagePlacement == ImagePlacement.Background, "background-repeat", LayoutDefaults.Image.DefaultBackgroundRepeat)
        .Build();

    private string ResolvedAccentColor =>
        ModifierOrEmpty.AccentColorValue ?? NavigationDefaults.Navbar.DefaultAccentColor;

    private UIModifier BuildNavbarWindowModifier() => UIModifier.Empty
        .Width(ModifierOrEmpty.WidthValue ?? NavigationDefaults.Navbar.Width)
        .Height(ModifierOrEmpty.HeightValue ?? NavigationDefaults.Navbar.Height)
        .MinHeight(ModifierOrEmpty.MinHeightValue ?? NavigationDefaults.Navbar.MinHeight)
        .Padding(ModifierOrEmpty.PaddingValue ?? NavigationDefaults.Navbar.Padding)
        .BorderRadius(ModifierOrEmpty.BorderRadiusValue ?? NavigationDefaults.Navbar.DefaultBorderRadius)
        .Background(ModifierOrEmpty.BackgroundValue ?? NavigationDefaults.Navbar.DefaultBackgroundColor)
        .BorderColor(ModifierOrEmpty.BorderColorValue ?? NavigationDefaults.Navbar.DefaultBorderColor)
        .Row()
        .AlignItems("center");

    private string BuildWrapperCssClasses() => new CssBuilder()
        .Add("ui-navbar-wrapper")
        .AddRaw(ModifierClass)
        .Build();
}