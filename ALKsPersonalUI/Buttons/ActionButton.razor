@inherits UIComponentBase
@inject UIThemeService ThemeService
@implements IDisposable

<button class="@BuildButtonCssClasses()"
        style="@BuildButtonInlineStyles()"
        type="@HtmlButtonType"
        disabled="@IsInteractionBlocked"
        @onclick="HandleClickAsync"
        @oncontextmenu="HandleContextMenu"
        @oncontextmenu:preventDefault="@HasSpecialPressBehavior"
        @onpointerdown="HandlePointerDownAsync"
        @onpointerup="CancelPressTimers"
        @onpointerleave="CancelPressTimers"
        @onpointercancel="CancelPressTimers"
        @attributes="AdditionalAttributes">
    <span class="btn-front">
        @if (IsHoldToConfirmEnabled)
        {
            <span class="btn-hold-fill"></span>
        }
        <span class="btn-content">
            @if (IsLoading)
            {
                <SimpleSpinner />
            }
            else if (ChildContent is not null)
            {
                @ChildContent
            }
            else
            {
                @if (ShouldRenderInlineImage)
                {
                    <img class="btn-image"
                         src="@ImageSource"
                         alt="@ResolvedImageAlt"
                         draggable="false" />
                }
                @if (ShouldRenderTextLabel)
                {
                    <span>@Text</span>
                }
            }
        </span>
    </span>
</button>

@code {
    [Parameter] public string? Text { get; set; }
    [Parameter] public string? ImageSource { get; set; }
    [Parameter] public string? ImageAlt { get; set; }
    [Parameter] public string? ImageSize { get; set; }
    [Parameter] public ImageFit ImageFit { get; set; } = ImageFit.Cover;
    [Parameter] public ImagePlacement ImagePlacement { get; set; } = ImagePlacement.Start;
    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }
    [Parameter] public EventCallback OnLongPress { get; set; }
    [Parameter] public bool IsDisabled { get; set; }
    [Parameter] public bool IsLoading { get; set; }

    [Parameter] public ButtonVariant Variant { get; set; } = ButtonVariant.Solid;
    [Parameter] public ButtonShape Shape { get; set; } = ButtonShape.Rounded;
    [Parameter] public ButtonSize Size { get; set; } = ButtonSize.Dynamic;
    [Parameter] public ButtonType Type { get; set; } = ButtonType.Button;
    [Parameter] public ButtonPressEffect? PressEffect { get; set; }

    [Parameter] public int HoldToConfirmDurationMilliseconds { get; set; }
    [Parameter] public int LongPressTriggerDurationMilliseconds { get; set; } = 600;

    /// <summary>
    /// When true, holding the button down continuously invokes OnClick with accelerating speed.
    /// Ideal for stepper buttons (+/-), Backspace, and Arrow keys on touch screens.
    /// </summary>
    [Parameter] public bool AutoRepeat { get; set; }

    private CancellationTokenSource? _pressGestureCancellationTokenSource;
    private bool _isHoldToConfirmActive;
    private bool _suppressNextClick;
    private string? _detectedPointerType;

    private bool IsInteractionBlocked => IsDisabled || IsLoading;
    private bool IsHoldToConfirmEnabled => HoldToConfirmDurationMilliseconds > 0;
    private bool HasSpecialPressBehavior => IsHoldToConfirmEnabled || OnLongPress.HasDelegate || AutoRepeat;
    private string HtmlButtonType => Type.ToString().ToLowerInvariant();
    private bool HasImageSource => !string.IsNullOrWhiteSpace(ImageSource);
    private bool ShouldRenderInlineImage => HasImageSource && ImagePlacement != ImagePlacement.Background;
    private bool ShouldRenderTextLabel => !string.IsNullOrWhiteSpace(Text) && (!HasImageSource || ImagePlacement != ImagePlacement.ReplaceText);
    private bool IsTextReplacedByImage => HasImageSource && ImagePlacement == ImagePlacement.ReplaceText;
    private string ResolvedImageAlt => ImageAlt ?? Text ?? string.Empty;

    private string? ResolveBackgroundImageCss()
    {
        if (HasImageSource && ImagePlacement == ImagePlacement.Background)
            return LayoutDefaults.FormatCssUrl(ImageSource);

        return LayoutDefaults.FormatCssUrl(ModifierOrEmpty.BackgroundImageSourceValue);
    }

    private string ResolveBackgroundSizeCss()
    {
        if (HasImageSource && ImagePlacement == ImagePlacement.Background)
            return LayoutDefaults.ToCss(ImageFit);

        return ModifierOrEmpty.BackgroundSizeValue ?? "cover";
    }

    private string? ResolveButtonImageSize()
    {
        if (!string.IsNullOrWhiteSpace(ImageSize))
            return ImageSize;

        return IsTextReplacedByImage ? "100%" : null;
    }

    private ButtonPressEffect ConfiguredPressEffect =>
        PressEffect ?? ThemeService.Current.DefaultPressEffect;

    private string ResolvedPressEffectClass
    {
        get
        {
            if (ConfiguredPressEffect != ButtonPressEffect.Auto)
                return $"press-{ConfiguredPressEffect.ToString().ToLowerInvariant()}";

            return _detectedPointerType switch
            {
                "touch" or "pen" => "press-inwardscale",
                "mouse" => "press-down3d",
                _ => "press-auto"
            };
        }
    }

    private (string VerticalPadding, string HorizontalPadding, string FontSize) ResolvedSizeMetrics => Size switch
    {
        ButtonSize.Small => ButtonDefaults.SmallMetrics,
        ButtonSize.Medium => ButtonDefaults.MediumMetrics,
        ButtonSize.Large => ButtonDefaults.LargeMetrics,
        _ => ResolveCustomMetrics()
    };

    private (string VerticalPadding, string HorizontalPadding, string FontSize) ResolveCustomMetrics()
    {
        var verticalPadding = ModifierOrEmpty.PaddingVerticalValue ?? "0.75rem";
        var horizontalPadding = ModifierOrEmpty.PaddingHorizontalValue ?? "1.5rem";
        var fontSize = ModifierOrEmpty.FontSizeValue ?? ButtonDefaults.DefaultFontSize;
        return (verticalPadding, horizontalPadding, fontSize);
    }

    private string BuildButtonCssClasses() => new CssBuilder()
        .Add("action-btn")
        .Add($"variant-{Variant.ToString().ToLowerInvariant()}")
        .Add($"shape-{Shape.ToString().ToLowerInvariant()}")
        .Add(ResolvedPressEffectClass)
        .Add("is-loading", when: IsLoading)
        .Add("is-holding", when: _isHoldToConfirmActive)
        .Add("has-replaced-text", when: IsTextReplacedByImage)
        .AddRaw(ModifierClass)
        .Build();

    private string BuildButtonInlineStyles() => new StyleBuilder()
        .Add("--_btn-base", ModifierOrEmpty.BaseColorValue ?? ButtonDefaults.DefaultBaseColor)
        .Add("--_btn-text", ModifierOrEmpty.TextColorValue ?? ButtonDefaults.DefaultTextColor)
        .Add("--_btn-bg-image", ResolveBackgroundImageCss())
        .Add("--_btn-bg-size", ResolveBackgroundSizeCss())
        .Add("--_btn-content-dir", LayoutDefaults.ToFlexDirectionCss(ImagePlacement))
        .Add("--_btn-img-size", ResolveButtonImageSize())
        .Add("--_btn-img-fit", LayoutDefaults.ToCss(ImageFit))
        .Add("--_btn-depth", ModifierOrEmpty.ButtonExtrusionDepthValue ?? ButtonDefaults.DefaultButtonExtrusionDepth)
        .Add("--_btn-scale", ModifierOrEmpty.InwardPressScaleFactorValue ?? "var(--ui-press-scale, 0.93)")
        .Add("--_btn-speed", ModifierOrEmpty.PressAnimationDurationValue ?? ButtonDefaults.DefaultPressAnimationDuration)
        .Add("--_btn-hold-ms", $"{HoldToConfirmDurationMilliseconds}ms")
        .Add("--_btn-pad-y", ResolvedSizeMetrics.VerticalPadding)
        .Add("--_btn-pad-x", ResolvedSizeMetrics.HorizontalPadding)
        .Add("--_btn-font", ResolvedSizeMetrics.FontSize)
        .Add("--_btn-width", ModifierOrEmpty.WidthValue ?? ButtonDefaults.DefaultWidth)
        .Add("--_btn-height", ModifierOrEmpty.HeightValue ?? ButtonDefaults.DefaultHeight)
        .Add("--_btn-min-width", ModifierOrEmpty.MinWidthValue)
        .Add("--_btn-min-height", ModifierOrEmpty.MinHeightValue)
        .AddRaw(ModifierOrEmpty.BuildFrameExtras())
        .Build();

    private void HandleContextMenu() { }

    private async Task HandleClickAsync(MouseEventArgs mouseEvent)
    {
        if (IsInteractionBlocked || IsHoldToConfirmEnabled)
            return;

        if (_suppressNextClick)
        {
            _suppressNextClick = false;
            return;
        }

        await OnClick.InvokeAsync(mouseEvent);
    }

    private async Task HandlePointerDownAsync(PointerEventArgs pointerEvent)
    {
        if (IsInteractionBlocked)
            return;

        if (!string.IsNullOrWhiteSpace(pointerEvent.PointerType))
            _detectedPointerType = pointerEvent.PointerType;

        _suppressNextClick = false;

        if (!HasSpecialPressBehavior)
            return;

        CancelPressTimers();
        _pressGestureCancellationTokenSource = new CancellationTokenSource();
        var cancellationToken = _pressGestureCancellationTokenSource.Token;

        if (AutoRepeat && !IsHoldToConfirmEnabled)
        {
            await RunAutoRepeatLoopAsync(cancellationToken);
            return;
        }

        _isHoldToConfirmActive = IsHoldToConfirmEnabled;
        var holdThresholdMilliseconds = IsHoldToConfirmEnabled
            ? HoldToConfirmDurationMilliseconds
            : LongPressTriggerDurationMilliseconds;

        try
        {
            await Task.Delay(holdThresholdMilliseconds, cancellationToken);
            if (!cancellationToken.IsCancellationRequested)
            {
                _isHoldToConfirmActive = false;

                if (IsHoldToConfirmEnabled)
                {
                    await OnClick.InvokeAsync(new MouseEventArgs());
                }
                else if (OnLongPress.HasDelegate)
                {
                    _suppressNextClick = true;
                    await OnLongPress.InvokeAsync();
                }

                StateHasChanged();
            }
        }
        catch (TaskCanceledException)
        {
            // User released early
        }
    }

    private async Task RunAutoRepeatLoopAsync(CancellationToken cancellationToken)
    {
        try
        {
            await Task.Delay(400, cancellationToken);
            var autoRepeatIntervalMilliseconds = 130;

            while (!cancellationToken.IsCancellationRequested && !IsInteractionBlocked)
            {
                _suppressNextClick = true;
                await OnClick.InvokeAsync(new MouseEventArgs());
                StateHasChanged();

                await Task.Delay(autoRepeatIntervalMilliseconds, cancellationToken);
                if (autoRepeatIntervalMilliseconds > 45)
                    autoRepeatIntervalMilliseconds -= 15;
            }
        }
        catch (TaskCanceledException)
        {
            // Released
        }
    }

    private void CancelPressTimers()
    {
        if (_pressGestureCancellationTokenSource is not null)
        {
            _pressGestureCancellationTokenSource.Cancel();
            _pressGestureCancellationTokenSource.Dispose();
            _pressGestureCancellationTokenSource = null;
        }
        _isHoldToConfirmActive = false;
    }

    public void Dispose() => CancelPressTimers();

    public enum ButtonVariant { Solid, Outline, Ghost }
    public enum ButtonShape { Rectangle, Rounded, Pill }
    public enum ButtonSize { Dynamic, Small, Medium, Large }
    public enum ButtonType { Button, Submit, Reset }
}