@inject ToastService ToastService
@implements IDisposable

<div class="ui-toast-container" aria-live="polite">
    @foreach (var toast in ToastService.GetToasts())
    {
        <div @key="toast.Id" class="toast-item">
            <Window Modifier="@BuildToastModifier(toast.Variant)" role="status">
                <div class="toast-inner">
                    <span>@toast.Text</span>
                    <CloseButton Shape="ActionButton.ButtonShape.Pill"
                                 AriaLabel="@DismissAriaLabel"
                                 OnClick="() => ToastService.Remove(toast.Id)" />
                </div>
            </Window>
        </div>
    }
</div>

@code {
    /// <summary>Accessible label for the dismiss button on each toast notification.</summary>
    [Parameter] public string DismissAriaLabel { get; set; } = OverlayDefaults.Toast.DismissAriaLabel;

    private bool _isDisposed;

    protected override void OnInitialized() =>
        ToastService.OnChange += RefreshToastDisplay;

    private void RefreshToastDisplay()
    {
        if (_isDisposed)
        {
            return;
        }

        try
        {
            _ = InvokeAsync(StateHasChanged);
        }
        catch (ObjectDisposedException)
        {
            // Ignore late notifications after component disposal.
        }
    }

    private static UIModifier BuildToastModifier(ToastVariant variant) => UIModifier.Empty
        .Width(OverlayDefaults.Toast.Width)
        .Height(OverlayDefaults.Toast.Height)
        .MinHeight(OverlayDefaults.Toast.MinHeight)
        .Padding(OverlayDefaults.Toast.Padding)
        .BorderRadius(OverlayDefaults.Toast.BorderRadius)
        .Row()
        .AlignItems("center")
        .Background(OverlayDefaults.Toast.BackgroundColor)
        .BorderColor(ResolveBorderColorForVariant(variant));

    private static string ResolveBorderColorForVariant(ToastVariant variant) => variant switch
    {
        ToastVariant.Success => OverlayDefaults.Toast.SuccessBorderColor,
        ToastVariant.Warning => OverlayDefaults.Toast.WarningBorderColor,
        ToastVariant.Danger => OverlayDefaults.Toast.DangerBorderColor,
        _ => OverlayDefaults.Toast.InfoBorderColor
    };

    public void Dispose()
    {
        _isDisposed = true;
        ToastService.OnChange -= RefreshToastDisplay;
    }
}