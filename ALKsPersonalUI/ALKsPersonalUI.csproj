<Project Sdk="Microsoft.NET.Sdk.Razor">

	<PropertyGroup>
		<TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>

		<PackageId>ALKsPersonalUI</PackageId>
		<Version>3.0.0-alpha.2</Version>
		<Authors>Andreas Liepins Krusager</Authors>
		<Company>Andreas Liepins Krusager</Company>
		<Title>ALK's Personal UI</Title>
		<Description>Custom tactile dark-mode &amp; touch-ready UI library for Blazor: windows, auto-adaptive 3D/touch buttons, virtual keyboards, numpads, inputs, modals, bottom sheets, toasts, sliders, and planetary loaders.</Description>
		<PackageTags>blazor;ui;components;dark-mode;tactile;touch;kiosk;keyboard;numpad;modal;toast;slider;controls;compose</PackageTags>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageReadmeFile>README.md</PackageReadmeFile>

		<GeneratePackageOnBuild>false</GeneratePackageOnBuild>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>

		<StaticWebAssetsFingerprintContent>false</StaticWebAssetsFingerprintContent>
		<StaticWebAssetFingerprintingEnabled>false</StaticWebAssetFingerprintingEnabled>
	</PropertyGroup>

	<ItemGroup>
		<SupportedPlatform Include="browser" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
		<PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="8.0.*" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
		<PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="9.0.*" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
		<PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.*" />
	</ItemGroup>

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" Condition="Exists('README.md')" />
		<None Include="..\README.md" Pack="true" PackagePath="\" Condition="!Exists('README.md') And Exists('..\README.md')" />
		<None Update="buildTransitive\ALKsPersonalUI.targets" Pack="true" PackagePath="buildTransitive\ALKsPersonalUI.targets;build\ALKsPersonalUI.targets" />
	</ItemGroup>

</Project>