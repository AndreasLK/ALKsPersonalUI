@inherits UIComponentBase

<label class="@BuildWrapperCssClasses()" style="@BuildCustomCssVariables()">
    <input type="checkbox"
           class="checkbox-native"
           checked="@Checked"
           disabled="@Disabled"
           aria-label="@AriaLabel"
           @onchange="OnCheckboxChangedAsync"
           @attributes="AdditionalAttributes" />

    @if (RenderAsToggleSwitch)
    {
        <span class="switch-track" aria-hidden="true">
            <span class="switch-thumb"></span>
        </span>
    }
    else
    {
        <span class="checkbox-box" aria-hidden="true">
            <svg class="checkbox-icon" viewBox="0 0 16 16" fill="none">
                <path d="M3.5 8.5L6.5 11.5L12.5 4.5"
                      stroke="currentColor"
                      stroke-width="2.2"
                      stroke-linecap="round"
                      stroke-linejoin="round" />
            </svg>
        </span>
    }

    @if (HasLabelContent)
    {
        <span class="checkbox-label-group" style="@BuildLabelGroupStyles()">
            @if (ShouldRenderInlineLabelImage)
            {
                <img class="checkbox-label-image"
                     src="@LabelImageSource"
                     alt="@ResolvedLabelImageAlt"
                     draggable="false" />
            }
            @if (ShouldRenderLabelText)
            {
                <span class="checkbox-label">@Label</span>
            }
        </span>
    }
</label>

@code {
    [Parameter] public bool Checked { get; set; }
    [Parameter] public EventCallback<bool> CheckedChanged { get; set; }
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? LabelImageSource { get; set; }
    [Parameter] public string? LabelImageAlt { get; set; }
    [Parameter] public string? LabelImageSize { get; set; }
    [Parameter] public ImageFit LabelImageFit { get; set; } = ImageFit.Cover;
    [Parameter] public ImagePlacement LabelImagePlacement { get; set; } = ImagePlacement.Start;
    [Parameter] public string? AriaLabel { get; set; }
    [Parameter] public bool RenderAsToggleSwitch { get; set; }
    [Parameter] public bool Disabled { get; set; }

    private bool HasLabelText => !string.IsNullOrWhiteSpace(Label);
    private bool HasLabelImage => !string.IsNullOrWhiteSpace(LabelImageSource);
    private bool HasLabelContent => HasLabelText || HasLabelImage;
    private bool ShouldRenderInlineLabelImage => HasLabelImage && LabelImagePlacement != ImagePlacement.Background;
    private bool ShouldRenderLabelText => HasLabelText && (!HasLabelImage || LabelImagePlacement != ImagePlacement.ReplaceText);
    private string ResolvedLabelImageAlt => LabelImageAlt ?? Label ?? string.Empty;

    private string BuildLabelGroupStyles() => new StyleBuilder()
        .Add("--_cb-label-dir", LayoutDefaults.ToFlexDirectionCss(LabelImagePlacement))
        .Add("--_cb-img-size", LabelImageSize)
        .Add("--_cb-img-fit", LayoutDefaults.ToCss(LabelImageFit))
        .AddIf(HasLabelImage && LabelImagePlacement == ImagePlacement.Background, "background-image", LayoutDefaults.FormatCssUrl(LabelImageSource))
        .AddIf(HasLabelImage && LabelImagePlacement == ImagePlacement.Background, "background-size", LayoutDefaults.ToCss(LabelImageFit))
        .AddIf(HasLabelImage && LabelImagePlacement == ImagePlacement.Background, "background-position", LayoutDefaults.Image.DefaultObjectPosition)
        .AddIf(HasLabelImage && LabelImagePlacement == ImagePlacement.Background, "background-repeat", LayoutDefaults.Image.DefaultBackgroundRepeat)
        .Build();

    private async Task OnCheckboxChangedAsync(ChangeEventArgs changeEvent)
    {
        if (Disabled)
            return;

        Checked = (bool)(changeEvent.Value ?? false);
        await CheckedChanged.InvokeAsync(Checked);
    }

    private string BuildWrapperCssClasses() => new CssBuilder()
        .Add("checkbox-wrapper")
        .Add("disabled", when: Disabled)
        .AddRaw(ModifierClass)
        .Build();

    private string BuildCustomCssVariables() => new StyleBuilder()
        .Add("--_cb-size", ModifierOrEmpty.WidthValue ?? InputDefaults.Checkbox.DefaultSize)
        .Add("--_cb-accent", ModifierOrEmpty.AccentColorValue ?? InputDefaults.Checkbox.DefaultAccentColor)
        .Add("--_cb-bg", ModifierOrEmpty.BackgroundValue ?? "var(--ui-bg-surface)")
        .Add("--_cb-border", ModifierOrEmpty.BorderColorValue ?? "var(--ui-border)")
        .Add("--_cb-text", ModifierOrEmpty.TextColorValue ?? "var(--ui-text)")
        .AddRaw(ModifierOrEmpty.BuildFrameExtras())
        .Build();
}