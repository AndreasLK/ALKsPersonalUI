    private void CycleShiftState()
    {
        if (!_isShiftActive && !_isCapsLocked)
            _isShiftActive = true;
        else if (_isShiftActive && !_isCapsLocked)
        {
            _isShiftActive = false;
            _isCapsLocked = true;
        }
        else
        {
            _isShiftActive = false;
            _isCapsLocked = false;
        }
    }

    private void ToggleCapsLock()
    {
        _isCapsLocked = !_isCapsLocked;
        _isShiftActive = false;
    }

    private void ToggleControlModifier() => _isControlModifierActive = !_isControlModifierActive;
    private void ToggleAltModifier() => _isAltModifierActive = !_isAltModifierActive;
    private void ToggleAltGraphModifier() => _isAltGraphModifierActive = !_isAltGraphModifierActive;
    private void ToggleSymbolsDrawer() => _showSymbolsDrawer = !_showSymbolsDrawer;

    private async Task PressPrintableKeyAsync(string keyText, string code)
    {
        var eventArgs = CreateKeyEventArgs(keyText, code, isPrintable: true);

        var isKeyboardShortcutCombination = _isControlModifierActive || _isAltModifierActive;
        if (isKeyboardShortcutCombination)
        {
            RecordKeyComboDisplay(eventArgs);
        }
        else
        {
            _lastPressedKeyCombinationText = null;
            var currentTextValue = Value ?? string.Empty;
            if (currentTextValue.Length + keyText.Length <= MaxLength)
            {
                Value = currentTextValue + keyText;
                await ValueChanged.InvokeAsync(Value);
            }
        }

        ResetOneShotModifiers();

        if (OnKeyPress.HasDelegate)
            await OnKeyPress.InvokeAsync(eventArgs);
    }

    private async Task HandleNavClusterKeyAsync(string label, string code)
    {
        if (code == "Delete" && !_isControlModifierActive && !_isAltModifierActive)
            await ClearTextAsync();

        await FireNonPrintableKeyAsync(label, code);
    }

    private async Task HandleNumpadEnterAsync()
    {
        await FireNonPrintableKeyAsync("Enter", "NumpadEnter");
        if (OnSubmit.HasDelegate)
            await SubmitAsync();
    }

    private async Task FireNonPrintableKeyAsync(string key, string code)
    {
        var eventArgs = CreateKeyEventArgs(key, code, isPrintable: false);
        RecordKeyComboDisplay(eventArgs);
        ResetOneShotModifiers();

        if (OnKeyPress.HasDelegate)
            await OnKeyPress.InvokeAsync(eventArgs);
    }

    private VirtualKeyEventArgs CreateKeyEventArgs(string key, string code, bool isPrintable) =>
        new(
            Key: key,
            Code: code,
            Shift: IsShifted,
            Ctrl: _isControlModifierActive,
            Alt: _isAltModifierActive || _isAltGraphModifierActive,
            IsPrintable: isPrintable);

    private void RecordKeyComboDisplay(VirtualKeyEventArgs keyEvent)
    {
        var activeModifierLabels = new List<string>();
        if (keyEvent.Ctrl) activeModifierLabels.Add("Ctrl");
        if (keyEvent.Alt) activeModifierLabels.Add("Alt");
        if (keyEvent.Shift && !keyEvent.IsPrintable) activeModifierLabels.Add("Shift");
        activeModifierLabels.Add(keyEvent.Key == " " ? "Space" : keyEvent.Key);

        _lastPressedKeyCombinationText = string.Join(" + ", activeModifierLabels);
    }

    private void ResetOneShotModifiers()
    {
        if (_isShiftActive && !_isCapsLocked)
            _isShiftActive = false;

        _isControlModifierActive = false;
        _isAltModifierActive = false;
        _isAltGraphModifierActive = false;
    }

    private async Task BackspaceAsync()
    {
        var eventArgs = CreateKeyEventArgs("Backspace", "Backspace", isPrintable: false);

        if (!string.IsNullOrEmpty(Value))
        {
            Value = Value[..^1];
            if (string.IsNullOrEmpty(Value))
                _isShiftActive = true;
            await ValueChanged.InvokeAsync(Value);
        }

        if (OnKeyPress.HasDelegate)
            await OnKeyPress.InvokeAsync(eventArgs);
    }

    private async Task ClearTextAsync()
    {
        Value = string.Empty;
        _isShiftActive = true;
        _lastPressedKeyCombinationText = null;
        await ValueChanged.InvokeAsync(Value);
    }

    private async Task SubmitAsync() =>
        await OnSubmit.InvokeAsync(Value);
}