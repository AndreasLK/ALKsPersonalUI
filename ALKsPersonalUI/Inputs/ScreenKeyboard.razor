@inherits UIComponentBase

<Window Modifier="@BuildKeyboardWindowModifier()" @attributes="AdditionalAttributes">
    @if (ShowPreviewBar)
    {
        <div class="kb-preview-bar">
            <div class="kb-preview-text">
                @if (string.IsNullOrEmpty(Value))
                {
                    <span class="kb-placeholder">@Placeholder</span>
                }
                else
                {
                    <span class="kb-typed-value">@FormatPreviewText()</span><span class="kb-caret" aria-hidden="true">|</span>
                }
            </div>

            <div class="kb-preview-actions">
                @if (!string.IsNullOrEmpty(_lastPressedKeyCombinationText))
                {
                    <Pill Variant="Pill.PillVariant.Accent" Text="@GetKeyComboBadgeText()" />
                }

                <Pill Variant="Pill.PillVariant.Neutral"
                      Text="@GetLayoutBadgeText()"
                      OnClick="CycleKeyboardLayout" />

                @if (!string.IsNullOrEmpty(Value))
                {
                    <Pill Variant="Pill.PillVariant.Danger"
                          Text="Clear"
                          OnClick="ClearTextAsync" />
                }
            </div>
        </div>
    }

    <div class="kb-deck">
        @if (HasMainDeckSection)
        {
            <div class="kb-zone-main">
                @if (ActiveSetup.IncludeFunctionKeys)
                {
                    <div class="kb-row kb-f-row">
                        <ActionButton PressEffect="ButtonPressEffect.InwardScale"
                                      Variant="ActionButton.ButtonVariant.Outline"
                                      Modifier="@BuildMacroKeyModifier(1.2)"
                                      Text="Esc"
                                      OnClick="@(() => FireNonPrintableKeyAsync("Escape", "Escape"))" />

                        <div class="kb-f-spacer"></div>

                        @for (int functionKeyNumber = 1; functionKeyNumber <= 12; functionKeyNumber++)
                        {
                            var functionKeyLabel = "F" + functionKeyNumber;
                            <ActionButton PressEffect="ButtonPressEffect.InwardScale"
                                          Variant="ActionButton.ButtonVariant.Outline"
                                          Modifier="@BuildMacroKeyModifier(1)"
                                          Text="@functionKeyLabel"
                                          OnClick="@(() => FireNonPrintableKeyAsync(functionKeyLabel, functionKeyLabel))" />

                            @if (functionKeyNumber is 4 or 8)
                            {
                                <div class="kb-f-spacer"></div>
                            }
                        }
                    </div>
                }

                @if (ActiveSetup.IncludeNumbers)
                {
                    <div class="kb-row">
                        @if (ActiveSetup.IncludeSpecialCharacters)
                        {
                            var topLeftSymbolCharacter = IsShifted ? "\u00A7" : "\u00BD";
                            <ActionButton PressEffect="ButtonPressEffect.InwardScale"
                                          Modifier="@BuildCharacterKeyModifier(1)"
                                          Text="@topLeftSymbolCharacter"
                                          OnClick="@(() => PressPrintableKeyAsync(topLeftSymbolCharacter, "Backquote"))" />
                        }

                        @for (int digitIndex = 0; digitIndex < _numberRowDigits.Length; digitIndex++)
                        {
                            var digit = _numberRowDigits[digitIndex];
                            var shiftedSymbol = _numberRowShiftedSymbols[digitIndex];
                            var displayCharacter = (IsShifted && ActiveSetup.IncludeSpecialCharacters) ? shiftedSymbol : digit;
                            var digitCode = "Digit" + digit;

                            <ActionButton PressEffect="ButtonPressEffect.InwardScale"
                                          Modifier="@BuildCharacterKeyModifier(1)"
                                          Text="@displayCharacter"
                                          OnClick="@(() => PressPrintableKeyAsync(displayCharacter, digitCode))" />
                        }

                        <ActionButton PressEffect="ButtonPressEffect.InwardScale"
                                      Variant="ActionButton.ButtonVariant.Outline"
                                      AutoRepeat="true"
                                      Modifier="@BuildFunctionKeyModifier(1.65)"
                                      Text="@InputDefaults.Symbols.Backspace"
                                      aria-label="Backspace"
                                      OnClick="BackspaceAsync" />
                    </div>
                }

                @if (ActiveSetup.IncludeLetters)
                {
                    var alphabetRows = GetActiveAlphabetRows();
                    @for (int rowIndex = 0; rowIndex < alphabetRows.Length; rowIndex++)
                    {
                        var currentRow = alphabetRows[rowIndex];
                        <div class="kb-row">
                            @if (rowIndex == 0)
                            {
                                @if (ActiveSetup.IncludeDesktopModifierKeys)
                                {
                                    <ActionButton PressEffect="ButtonPressEffect.InwardScale"
                                                  Variant="ActionButton.ButtonVariant.Outline"
                                                  Modifier="@BuildFunctionKeyModifier(1.3)"
                                                  Text="@GetTabButtonLabel()"
                                                  OnClick="@(() => FireNonPrintableKeyAsync("Tab", "Tab"))" />
                                }
                            }
                            else if (rowIndex == 1)
                            {
                                @if (ActiveSetup.IncludeDesktopModifierKeys)
                                {
                                    <ActionButton PressEffect="ButtonPressEffect.InwardScale"
                                                  Variant="@(_isCapsLocked ? ActionButton.ButtonVariant.Solid : ActionButton.ButtonVariant.Outline)"
                                                  Modifier="@BuildFunctionKeyModifier(1.7, _isCapsLocked)"
                                                  Text="Caps"
                                                  OnClick="ToggleCapsLock" />
                                }
                                else
                                {
                                    <div class="kb-stagger-spacer" style="@GetHomeRowLeftStaggerStyle()"></div>
                                }
                            }
                            else if (rowIndex == 2)
                            {
                                <ActionButton PressEffect="ButtonPressEffect.InwardScale"
                                              Variant="@(IsShifted ? ActionButton.ButtonVariant.Solid : ActionButton.ButtonVariant.Outline)"
                                              Modifier="@BuildFunctionKeyModifier(ActiveSetup.IncludeDesktopModifierKeys ? 2.15 : 1.55, IsShifted)"
                                              Text="@GetLeftShiftLabel()"
                                              aria-label="Shift"
                                              OnClick="CycleShiftState" />
                            }

                            @foreach (var letter in currentRow)
                            {
                                var formattedLetter = FormatLetterCase(letter);
                                var letterCode = "Key" + letter.ToUpperInvariant();
                                <ActionButton PressEffect="ButtonPressEffect.InwardScale"
                                              Modifier="@BuildCharacterKeyModifier(1)"
                                              Text="@formattedLetter"
                                              OnClick="@(() => PressPrintableKeyAsync(formattedLetter, letterCode))" />
                            }

                            @if (rowIndex == 2 && ActiveSetup.IncludeSpecialCharacters)
                            {
                                @foreach (var punctuationSymbol in GetBottomRowPunctuationSymbols())
                                {
                                    var capturedPunctuation = punctuationSymbol;
                                    <ActionButton PressEffect="ButtonPressEffect.InwardScale"
                                                  Modifier="@BuildCharacterKeyModifier(1)"
                                                  Text="@capturedPunctuation"
                                                  OnClick="@(() => PressPrintableKeyAsync(capturedPunctuation, "Punctuation"))" />
                                }
                            }

                            @if (rowIndex == 0)
                            {
                                @if (!ActiveSetup.IncludeNumbers)
                                {
                                    <ActionButton PressEffect="ButtonPressEffect.InwardScale"
                                                  Variant="ActionButton.ButtonVariant.Outline"
                                                  AutoRepeat="true"
                                                  Modifier="@BuildFunctionKeyModifier(1.45)"
                                                  Text="@InputDefaults.Symbols.Backspace"
                                                  aria-label="Backspace"
                                                  OnClick="BackspaceAsync" />
                                }
                                else
                                {
                                    <div class="kb-stagger-spacer" style="flex: 0.4 1 0%;"></div>
                                }
                            }
                            else if (rowIndex == 1)
                            {
                                <div class="kb-stagger-spacer" style="@GetHomeRowRightStaggerStyle()"></div>
                            }
                            else if (rowIndex == 2)
                            {
                                @if (ActiveSetup.IncludeNumbers)
                                {
                                    <ActionButton PressEffect="ButtonPressEffect.InwardScale"
                                                  Variant="@(IsShifted ? ActionButton.ButtonVariant.Solid : ActionButton.ButtonVariant.Outline)"
                                                  Modifier="@BuildFunctionKeyModifier(ActiveSetup.IncludeDesktopModifierKeys ? 2.15 : 1.55, IsShifted)"
                                                  Text="@InputDefaults.Symbols.ShiftUp"
                                                  aria-label="Right Shift"
                                                  OnClick="CycleShiftState" />
                                }
                            }
                        </div>
                    }
                }

                @if (_showSymbolsDrawer && ActiveSetup.IncludeSpecialCharacters)
                {
                    <div class="kb-row">
                        @foreach (var specialSymbol in _drawerSpecialSymbols)
                        {
                            var capturedSymbol = specialSymbol;
                            <ActionButton PressEffect="ButtonPressEffect.InwardScale"
                                          Modifier="@BuildCharacterKeyModifier(1)"
                                          Text="@capturedSymbol"
                                          OnClick="@(() => PressPrintableKeyAsync(capturedSymbol, "Symbol"))" />
                        }
                    </div>
                }

                <div class="kb-row kb-bottom-row">
                    @if (ActiveSetup.IncludeDesktopModifierKeys)
                    {
                        <ActionButton PressEffect="ButtonPressEffect.InwardScale"
                                      Variant="@(_isControlModifierActive ? ActionButton.ButtonVariant.Solid : ActionButton.ButtonVariant.Outline)"
                                      Modifier="@BuildFunctionKeyModifier(1.3, _isControlModifierActive)"
                                      Text="Ctrl"
                                      OnClick="ToggleControlModifier" />

                        <ActionButton PressEffect="ButtonPressEffect.InwardScale"
                                      Variant="@(_isAltModifierActive ? ActionButton.ButtonVariant.Solid : ActionButton.ButtonVariant.Outline)"
                                      Modifier="@BuildFunctionKeyModifier(1.3, _isAltModifierActive)"
                                      Text="Alt"
                                      OnClick="ToggleAltModifier" />
                    }

                    @if (ActiveSetup.IncludeSpecialCharacters)
                    {
                        <ActionButton PressEffect="ButtonPressEffect.InwardScale"
                                      Variant="@(_showSymbolsDrawer ? ActionButton.ButtonVariant.Solid : ActionButton.ButtonVariant.Outline)"
                                      Modifier="@BuildFunctionKeyModifier(1.4, _showSymbolsDrawer)"
                                      Text="@(_showSymbolsDrawer ? "ABC" : "#+=")"
                                      OnClick="ToggleSymbolsDrawer" />
                    }

                    @if (ActiveSetup.IncludeLetters)
                    {
                        <ActionButton PressEffect="ButtonPressEffect.InwardScale"
                                      Modifier="@BuildSpaceKeyModifier()"
                                      Text="Space"
                                      OnClick="@(() => PressPrintableKeyAsync(" ", "Space"))" />
                    }

                    @if (ActiveSetup.IncludeDesktopModifierKeys)
                    {
                        <ActionButton PressEffect="ButtonPressEffect.InwardScale"
                                      Variant="@(_isAltGraphModifierActive ? ActionButton.ButtonVariant.Solid : ActionButton.ButtonVariant.Outline)"
                                      Modifier="@BuildFunctionKeyModifier(1.3, _isAltGraphModifierActive)"
                                      Text="AltGr"
                                      OnClick="ToggleAltGraphModifier" />

                        <ActionButton PressEffect="ButtonPressEffect.InwardScale"
                                      Variant="@(_isControlModifierActive ? ActionButton.ButtonVariant.Solid : ActionButton.ButtonVariant.Outline)"
                                      Modifier="@BuildFunctionKeyModifier(1.3, _isControlModifierActive)"
                                      Text="Ctrl"
                                      OnClick="ToggleControlModifier" />
                    }

                    @if (OnSubmit.HasDelegate)
                    {
                        <ActionButton PressEffect="ButtonPressEffect.InwardScale"
                                      Modifier="@BuildSubmitKeyModifier()"
                                      Text="@SubmitText"
                                      OnClick="SubmitAsync" />
                    }
                    else if (ActiveSetup.IncludeDesktopModifierKeys)
                    {
                        <ActionButton PressEffect="ButtonPressEffect.InwardScale"
                                      Modifier="@BuildSubmitKeyModifier()"
                                      Text="@GetEnterButtonLabel()"
                                      OnClick="@(() => FireNonPrintableKeyAsync("Enter", "Enter"))" />
                    }
                </div>
            </div>
        }

        @if (HasNavigationDeckSection)
        {
            <div class="kb-zone-nav">
                @if (ActiveSetup.IncludeSystemKeys)
                {
                    <div class="kb-nav-grid-3 kb-sys-cluster">
                        <ActionButton PressEffect="ButtonPressEffect.InwardScale"
                                      Variant="ActionButton.ButtonVariant.Outline"
                                      Modifier="@BuildGridMacroKeyModifier()"
                                      Text="PrtSc"
                                      OnClick="@(() => FireNonPrintableKeyAsync("PrintScreen", "PrintScreen"))" />
                        <ActionButton PressEffect="ButtonPressEffect.InwardScale"
                                      Variant="ActionButton.ButtonVariant.Outline"
                                      Modifier="@BuildGridMacroKeyModifier()"
                                      Text="ScrLk"
                                      OnClick="@(() => FireNonPrintableKeyAsync("ScrollLock", "ScrollLock"))" />
                        <ActionButton PressEffect="ButtonPressEffect.InwardScale"
                                      Variant="ActionButton.ButtonVariant.Outline"
                                      Modifier="@BuildGridMacroKeyModifier()"
                                      Text="Pause"
                                      OnClick="@(() => FireNonPrintableKeyAsync("Pause", "Pause"))" />
                    </div>
                }

                @if (ActiveSetup.IncludeNavigationCluster)
                {
                    <div class="kb-nav-grid-3 kb-ins-cluster">
                        @foreach (var navigationKey in _navigationClusterKeys)
                        {
                            var capturedNavKey = navigationKey;
                            <ActionButton PressEffect="ButtonPressEffect.InwardScale"
                                          Variant="ActionButton.ButtonVariant.Outline"
                                          Modifier="@BuildGridMacroKeyModifier()"
                                          Text="@capturedNavKey.Label"
                                          OnClick="@(() => HandleNavClusterKeyAsync(capturedNavKey.Label, capturedNavKey.Code))" />
                        }
                    </div>
                }

                @if (ActiveSetup.IncludeArrowKeys)
                {
                    <div class="kb-arrow-cluster">
                        <div class="kb-nav-grid-3">
                            <div></div>
                            <ActionButton PressEffect="ButtonPressEffect.InwardScale"
                                          AutoRepeat="true"
                                          Modifier="@BuildArrowKeyModifier()"
                                          Text="@InputDefaults.Symbols.ArrowUp"
                                          aria-label="Up Arrow"
                                          OnClick="@(() => FireNonPrintableKeyAsync("ArrowUp", "ArrowUp"))" />
                            <div></div>

                            <ActionButton PressEffect="ButtonPressEffect.InwardScale"
                                          AutoRepeat="true"
                                          Modifier="@BuildArrowKeyModifier()"
                                          Text="@InputDefaults.Symbols.ArrowLeft"
                                          aria-label="Left Arrow"
                                          OnClick="@(() => FireNonPrintableKeyAsync("ArrowLeft", "ArrowLeft"))" />
                            <ActionButton PressEffect="ButtonPressEffect.InwardScale"
                                          AutoRepeat="true"
                                          Modifier="@BuildArrowKeyModifier()"
                                          Text="@InputDefaults.Symbols.ArrowDown"
                                          aria-label="Down Arrow"
                                          OnClick="@(() => FireNonPrintableKeyAsync("ArrowDown", "ArrowDown"))" />
                            <ActionButton PressEffect="ButtonPressEffect.InwardScale"
                                          AutoRepeat="true"
                                          Modifier="@BuildArrowKeyModifier()"
                                          Text="@InputDefaults.Symbols.ArrowRight"
                                          aria-label="Right Arrow"
                                          OnClick="@(() => FireNonPrintableKeyAsync("ArrowRight", "ArrowRight"))" />
                        </div>
                    </div>
                }
            </div>
        }

        @if (ActiveSetup.IncludeNumpad)
        {
            <div class="kb-zone-numpad">
                @if (ActiveSetup.IncludeFunctionKeys)
                {
                    <div class="kb-numpad-f-offset" aria-hidden="true"></div>
                }

                <div class="kb-numpad-grid">
                    <ActionButton PressEffect="ButtonPressEffect.InwardScale"
                                  Variant="ActionButton.ButtonVariant.Outline"
                                  Modifier="@BuildGridMacroKeyModifier()"
                                  Text="Num"
                                  OnClick="@(() => FireNonPrintableKeyAsync("NumLock", "NumLock"))" />

                    @if (ActiveSetup.IncludeSpecialCharacters)
                    {
                        <ActionButton PressEffect="ButtonPressEffect.InwardScale"
                                      Variant="ActionButton.ButtonVariant.Outline"
                                      Modifier="@BuildGridMacroKeyModifier()"
                                      Text="/"
                                      OnClick="@(() => PressPrintableKeyAsync("/", "NumpadDivide"))" />
                        <ActionButton PressEffect="ButtonPressEffect.InwardScale"
                                      Variant="ActionButton.ButtonVariant.Outline"
                                      Modifier="@BuildGridMacroKeyModifier()"
                                      Text="*"
                                      OnClick="@(() => PressPrintableKeyAsync("*", "NumpadMultiply"))" />
                        <ActionButton PressEffect="ButtonPressEffect.InwardScale"
                                      Variant="ActionButton.ButtonVariant.Outline"
                                      Modifier="@BuildGridMacroKeyModifier()"
                                      Text="-"
                                      OnClick="@(() => PressPrintableKeyAsync("-", "NumpadSubtract"))" />
                    }
                    else
                    {
                        <ActionButton PressEffect="ButtonPressEffect.InwardScale"
                                      Variant="ActionButton.ButtonVariant.Outline"
                                      Modifier="@BuildGridMacroKeyModifier()"
                                      Text="C"
                                      OnClick="ClearTextAsync" />
                        <ActionButton PressEffect="ButtonPressEffect.InwardScale"
                                      Variant="ActionButton.ButtonVariant.Outline"
                                      AutoRepeat="true"
                                      Modifier="@BuildGridMacroKeyModifier()"
                                      Text="@InputDefaults.Symbols.Backspace"
                                      OnClick="BackspaceAsync" />
                        <ActionButton PressEffect="ButtonPressEffect.InwardScale"
                                      Variant="ActionButton.ButtonVariant.Outline"
                                      Modifier="@BuildGridMacroKeyModifier()"
                                      Text="-"
                                      OnClick="@(() => PressPrintableKeyAsync("-", "NumpadSubtract"))" />
                    }

                    @foreach (var numpadDigit in _numpadTopRowDigits)
                    {
                        var capturedDigit = numpadDigit;
                        var numpadCode = "Numpad" + capturedDigit;
                        <ActionButton PressEffect="ButtonPressEffect.InwardScale"
                                      Modifier="@BuildGridCharacterKeyModifier()"
                                      Text="@capturedDigit"
                                      OnClick="@(() => PressPrintableKeyAsync(capturedDigit, numpadCode))" />
                    }

                    <ActionButton PressEffect="ButtonPressEffect.InwardScale"
                                  Variant="ActionButton.ButtonVariant.Outline"
                                  Modifier="@BuildNumpadTallPlusKeyModifier()"
                                  Text="+"
                                  aria-label="Numpad Plus"
                                  OnClick="@(() => PressPrintableKeyAsync("+", "NumpadAdd"))" />

                    @foreach (var numpadDigit in _numpadMiddleRowDigits)
                    {
                        var capturedDigit = numpadDigit;
                        var numpadCode = "Numpad" + capturedDigit;
                        <ActionButton PressEffect="ButtonPressEffect.InwardScale"
                                      Modifier="@BuildGridCharacterKeyModifier()"
                                      Text="@capturedDigit"
                                      OnClick="@(() => PressPrintableKeyAsync(capturedDigit, numpadCode))" />
                    }

                    @foreach (var numpadDigit in _numpadBottomRowDigits)
                    {
                        var capturedDigit = numpadDigit;
                        var numpadCode = "Numpad" + capturedDigit;
                        <ActionButton PressEffect="ButtonPressEffect.InwardScale"
                                      Modifier="@BuildGridCharacterKeyModifier()"
                                      Text="@capturedDigit"
                                      OnClick="@(() => PressPrintableKeyAsync(capturedDigit, numpadCode))" />
                    }

                    <ActionButton PressEffect="ButtonPressEffect.InwardScale"
                                  Modifier="@BuildNumpadTallEnterKeyModifier()"
                                  Text="@InputDefaults.Symbols.EnterReturn"
                                  aria-label="Numpad Enter"
                                  OnClick="HandleNumpadEnterAsync" />

                    <ActionButton PressEffect="ButtonPressEffect.InwardScale"
                                  Modifier="@BuildNumpadWideZeroKeyModifier()"
                                  Text="0"
                                  OnClick="@(() => PressPrintableKeyAsync("0", "Numpad0"))" />

                    <ActionButton PressEffect="ButtonPressEffect.InwardScale"
                                  Modifier="@BuildGridCharacterKeyModifier()"
                                  Text="."
                                  OnClick="@(() => PressPrintableKeyAsync(".", "NumpadDecimal"))" />
                </div>
            </div>
        }
    </div>
</Window>

@code {
    private static readonly string[] _numberRowDigits = ["1", "2", "3", "4", "5", "6", "7", "8", "9", "0"];
    private static readonly string[] _numberRowShiftedSymbols = ["!", "\"", "#", "\u00A4", "%", "&", "/", "(", ")", "="];
    private static readonly string[] _numpadTopRowDigits = ["7", "8", "9"];
    private static readonly string[] _numpadMiddleRowDigits = ["4", "5", "6"];
    private static readonly string[] _numpadBottomRowDigits = ["1", "2", "3"];
    private static readonly string[] _drawerSpecialSymbols = ["@", "\u0024", "{", "[", "]", "}", "\\", "|", "~", "^", "*", "+", "?", "_"];

    private static readonly (string Label, string Code)[] _navigationClusterKeys =
    [
        ("Ins", "Insert"), ("Home", "Home"), ("PgUp", "PageUp"),
        ("Del", "Delete"), ("End", "End"), ("PgDn", "PageDown")
    ];

    // Nordic: å = \u00E5, æ = \u00E6, ø = \u00F8
    private static readonly string[][] _nordicAlphabetRows =
    [
        ["q", "w", "e", "r", "t", "y", "u", "i", "o", "p", "\u00E5"],
        ["a", "s", "d", "f", "g", "h", "j", "k", "l", "\u00E6", "\u00F8"],
        ["z", "x", "c", "v", "b", "n", "m"]
    ];

    private static readonly string[][] _qwertyUsAlphabetRows =
    [
        ["q", "w", "e", "r", "t", "y", "u", "i", "o", "p"],
        ["a", "s", "d", "f", "g", "h", "j", "k", "l"],
        ["z", "x", "c", "v", "b", "n", "m"]
    ];

    // German: ü = \u00FC, ö = \u00F6, ä = \u00E4
    private static readonly string[][] _qwertzDeAlphabetRows =
    [
        ["q", "w", "e", "r", "t", "z", "u", "i", "o", "p", "\u00FC"],
        ["a", "s", "d", "f", "g", "h", "j", "k", "l", "\u00F6", "\u00E4"],
        ["y", "x", "c", "v", "b", "n", "m"]
    ];

    private static readonly string[][] _azertyFrAlphabetRows =
    [
        ["a", "z", "e", "r", "t", "y", "u", "i", "o", "p"],
        ["q", "s", "d", "f", "g", "h", "j", "k", "l", "m"],
        ["w", "x", "c", "v", "b", "n"]
    ];

    private readonly KeyboardSetup _fallbackSetup = KeyboardSetup.TouchStandard;

    [Parameter] public KeyboardSetup? Setup { get; set; }
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    [Parameter] public EventCallback<VirtualKeyEventArgs> OnKeyPress { get; set; }
    [Parameter] public bool ShowPreviewBar { get; set; } = true;
    [Parameter] public bool IsPassword { get; set; }
    [Parameter] public int MaxLength { get; set; } = InputDefaults.ScreenKeyboard.DefaultMaxLength;
    [Parameter] public string Placeholder { get; set; } = "Tap keys to type...";
    [Parameter] public string SubmitText { get; set; } = "Done \u2713";
    [Parameter] public EventCallback<string?> OnSubmit { get; set; }

    private KeyboardSetup ActiveSetup => Setup ?? _fallbackSetup;

    private bool _isShiftActive = true;
    private bool _isCapsLocked;
    private bool _isControlModifierActive;
    private bool _isAltModifierActive;
    private bool _isAltGraphModifierActive;
    private bool _showSymbolsDrawer;
    private string? _lastPressedKeyCombinationText;

    private bool IsShifted => _isShiftActive || _isCapsLocked;

    private bool HasMainDeckSection =>
        ActiveSetup.IncludeLetters ||
        ActiveSetup.IncludeNumbers ||
        ActiveSetup.IncludeFunctionKeys ||
        ActiveSetup.IncludeSpecialCharacters;

    private bool HasNavigationDeckSection =>
        ActiveSetup.IncludeSystemKeys ||
        ActiveSetup.IncludeNavigationCluster ||
        ActiveSetup.IncludeArrowKeys;

    private string GetKeyComboBadgeText() =>
        "Key: " + _lastPressedKeyCombinationText;

    private static string GetTabButtonLabel() =>
        "Tab " + InputDefaults.Symbols.TabRight;

    private static string GetEnterButtonLabel() =>
        "Enter " + InputDefaults.Symbols.EnterReturn;

    private string GetLeftShiftLabel()
    {
        if (_isCapsLocked)
            return "CAPS";
        if (ActiveSetup.IncludeDesktopModifierKeys)
            return InputDefaults.Symbols.ShiftUp + " Shift";
        return InputDefaults.Symbols.ShiftUp;
    }

    private string[][] GetActiveAlphabetRows() => ActiveSetup.LayoutValue switch
    {
        KeyboardLayout.QwertyUS => _qwertyUsAlphabetRows,
        KeyboardLayout.QwertzDE => _qwertzDeAlphabetRows,
        KeyboardLayout.AzertyFR => _azertyFrAlphabetRows,
        _ => _nordicAlphabetRows
    };

    private string GetHomeRowLeftStaggerStyle() =>
        ActiveSetup.LayoutValue == KeyboardLayout.QwertyUS
            ? "flex: 0.45 1 0%;"
            : "flex: 0.4 1 0%;";

    private string GetHomeRowRightStaggerStyle()
    {
        if (ActiveSetup.LayoutValue == KeyboardLayout.QwertyUS)
            return ActiveSetup.IncludeDesktopModifierKeys ? "flex: 1.0 1 0%;" : "flex: 0.95 1 0%;";

        return "flex: 0 0 0px;";
    }

    private string[] GetBottomRowPunctuationSymbols() =>
        IsShifted ? [";", ":", "_"] : [",", ".", "-"];

    private string GetLayoutBadgeText() => ActiveSetup.LayoutValue switch
    {
        KeyboardLayout.Nordic => "DA (\u00C6\u00D8\u00C5)",
        KeyboardLayout.QwertyUS => "EN (US)",
        KeyboardLayout.QwertzDE => "DE (\u00C4\u00D6\u00DC)",
        KeyboardLayout.AzertyFR => "FR (AZERTY)",
        _ => "DA"
    };

    private void CycleKeyboardLayout()
    {
        var nextLayout = ActiveSetup.LayoutValue switch
        {
            KeyboardLayout.Nordic => KeyboardLayout.QwertyUS,
            KeyboardLayout.QwertyUS => KeyboardLayout.QwertzDE,
            KeyboardLayout.QwertzDE => KeyboardLayout.AzertyFR,
            _ => KeyboardLayout.Nordic
        };
        ActiveSetup.Layout(nextLayout);
    }

    private string FormatLetterCase(string rawKey) =>
        IsShifted ? rawKey.ToUpperInvariant() : rawKey.ToLowerInvariant();

    private string FormatPreviewText()
    {
        if (string.IsNullOrEmpty(Value))
            return string.Empty;
        return IsPassword ? new string('\u25CF', Value.Length) : Value;
    }

    private UIModifier BuildKeyboardWindowModifier() => UIModifier.Empty
        .Width(ModifierOrEmpty.WidthValue ?? "100%")
        .Padding(ModifierOrEmpty.PaddingValue ?? "0.5rem")
        .Gap("0.45rem")
        .Background(ModifierOrEmpty.BackgroundValue ?? "var(--ui-bg-surface)")
        .BorderColor(ModifierOrEmpty.BorderColorValue ?? "var(--ui-border)")
        .BorderRadius(ModifierOrEmpty.BorderRadiusValue ?? "var(--ui-radius-lg)")
        .RawStyle(ModifierOrEmpty.BuildFrameExtras())
        .Class(ModifierClass);

    private UIModifier BuildCharacterKeyModifier(double flexGrowWeight) => UIModifier.Empty
        .Weight(flexGrowWeight)
        .MinWidth("0px")
        .MinHeight("2.9rem")
        .Padding("0.35rem", "0.1rem")
        .FontSize("1.05rem")
        .BaseColor(ModifierOrEmpty.BaseColorValue ?? "var(--ui-bg-elevated)")
        .TextColor(ModifierOrEmpty.TextColorValue ?? "var(--ui-text)")
        .InwardPressScaleFactor(0.92);

    private UIModifier BuildGridCharacterKeyModifier() => UIModifier.Empty
        .FillMaxWidth()
        .MinWidth("0px")
