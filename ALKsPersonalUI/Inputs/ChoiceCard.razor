@inherits UIComponentBase

<button type="button"
        class="@BuildCssClasses()"
        style="@BuildStyles()"
        disabled="@Disabled"
        aria-pressed="@(State == ChoiceCardState.Selected)"
        @onclick="HandleClickAsync"
        @attributes="AdditionalAttributes">
    @if (HasImage)
    {
        <img class="ui-choice-card-image"
             src="@ImageSource"
             alt="@ResolvedImageAlt"
             draggable="false" />
    }

    @if (HasTextContent)
    {
        <div class="ui-choice-card-body">
            @if (!string.IsNullOrWhiteSpace(Title))
            {
                <span class="ui-choice-card-title">@Title</span>
            }
            @if (!string.IsNullOrWhiteSpace(Description))
            {
                <span class="ui-choice-card-description">@Description</span>
            }
        </div>
    }

    @if (ChildContent is not null)
    {
        <div class="ui-choice-card-extra">
            @ChildContent
        </div>
    }
</button>

@code {
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Description { get; set; }
    [Parameter] public string? ImageSource { get; set; }
    [Parameter] public string? ImageAlt { get; set; }
    [Parameter] public ChoiceCardState State { get; set; } = ChoiceCardState.Neutral;
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }

    private bool HasImage => !string.IsNullOrWhiteSpace(ImageSource);
    private bool HasTextContent => !string.IsNullOrWhiteSpace(Title) || !string.IsNullOrWhiteSpace(Description);
    private string ResolvedImageAlt => ImageAlt ?? Title ?? string.Empty;

    private async Task HandleClickAsync()
    {
        if (Disabled)
            return;

        await OnClick.InvokeAsync();
    }

    private string BuildCssClasses() => new CssBuilder()
        .Add("ui-choice-card")
        .Add(State.ToString().ToLowerInvariant())
        .AddRaw(ModifierClass)
        .Build();

    private string BuildStyles() => new StyleBuilder()
        .Add("--_card-bg", ModifierOrEmpty.BackgroundValue)
        .Add("--_card-border", ModifierOrEmpty.BorderColorValue)
        .Add("--_card-text", ModifierOrEmpty.TextColorValue)
        .Add("--_card-accent", ModifierOrEmpty.AccentColorValue)
        .AddRaw(ModifierOrEmpty.BuildFrameExtras())
        .Build();
}
