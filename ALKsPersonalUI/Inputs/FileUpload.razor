@using System.Globalization
@using Microsoft.AspNetCore.Components.Forms
@inherits UIComponentBase

<div class="@BuildWrapperCssClasses()"
     style="@ModifierStyle"
     @attributes="AdditionalAttributes">
    <label class="file-upload-zone">
        <InputFile class="file-upload-input"
                   multiple="@AllowMultiple"
                   accept="@AcceptedExtensions"
                   disabled="@IsDisabled"
                   OnChange="HandleFilesSelectedAsync" />
        <span class="file-upload-prompt">@PromptText</span>
        @if (!string.IsNullOrWhiteSpace(AcceptedExtensions))
        {
            <span class="file-upload-hint">@AcceptedExtensions</span>
        }
    </label>

    @if (!string.IsNullOrWhiteSpace(_validationError))
    {
        <span class="file-upload-error" role="alert" aria-live="polite">@_validationError</span>
    }
</div>

@code {
    private const int BytesPerMegabyte = 1024 * 1024;

    [Parameter] public bool AllowMultiple { get; set; }
    [Parameter] public string AcceptedExtensions { get; set; } = InputDefaults.FileUpload.DefaultAcceptedExtensions;
    [Parameter] public long MaxFileSizeBytes { get; set; } = InputDefaults.FileUpload.DefaultMaxFileSizeBytes;
    [Parameter] public int MaxAllowedFiles { get; set; } = InputDefaults.FileUpload.DefaultMaxAllowedFiles;
    [Parameter] public string PromptText { get; set; } = InputDefaults.FileUpload.DefaultPromptText;
    /// <summary>Format string for oversized file errors. Receives the file name as {0} and max size in MB as {1}.</summary>
    [Parameter] public string FileSizeExceededErrorFormat { get; set; } = "'{0}' exceeds the maximum size of {1} MB.";
    /// <summary>Format string for unsupported file extension errors. Receives the file name as {0}.</summary>
    [Parameter] public string UnsupportedExtensionErrorFormat { get; set; } = "'{0}' has an unsupported file extension.";
    [Parameter] public bool IsDisabled { get; set; }
    [Parameter] public EventCallback<IReadOnlyList<IBrowserFile>> OnFilesSelected { get; set; }

    private string? _validationError;

    private async Task HandleFilesSelectedAsync(InputFileChangeEventArgs args)
    {
        _validationError = null;
        var selectedFiles = AllowMultiple
            ? args.GetMultipleFiles(MaxAllowedFiles)
            : [args.File];

        var validFiles = new List<IBrowserFile>(selectedFiles.Count);
        foreach (var file in selectedFiles)
        {
            if (file.Size > MaxFileSizeBytes)
            {
                _validationError = string.Format(
                    CultureInfo.CurrentCulture,
                    FileSizeExceededErrorFormat,
                    file.Name,
                    MaxFileSizeBytes / BytesPerMegabyte);
                return;
            }

            if (!IsExtensionAllowed(file.Name))
            {
                _validationError = string.Format(
                    CultureInfo.CurrentCulture,
                    UnsupportedExtensionErrorFormat,
                    file.Name);
                return;
            }

            validFiles.Add(file);
        }

        if (OnFilesSelected.HasDelegate)
        {
            await OnFilesSelected.InvokeAsync(validFiles);
        }
    }

    private bool IsExtensionAllowed(string fileName)
    {
        if (string.IsNullOrWhiteSpace(AcceptedExtensions))
        {
            return true;
        }

        var extension = Path.GetExtension(fileName);
        if (string.IsNullOrWhiteSpace(extension))
        {
            return false;
        }

        var allowed = AcceptedExtensions.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        return allowed.Any(ext => string.Equals(ext, extension, StringComparison.OrdinalIgnoreCase));
    }

    private string BuildWrapperCssClasses()
    {
        return new CssBuilder()
            .Add("file-upload")
            .Add("file-upload-disabled", IsDisabled)
            .AddRaw(ModifierClass)
            .Build();
    }
}

