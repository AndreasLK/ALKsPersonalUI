@using System.Globalization
@using Microsoft.AspNetCore.Components.Forms
@inherits UIComponentBase

<div class="@BuildWrapperCssClasses()"
     style="@ModifierStyle"
     @attributes="AdditionalAttributes">
    <label class="image-upload-zone">
        <InputFile class="image-upload-input"
                   multiple="@(AllowMultiple || AllowFolderUpload)"
                   accept="@AcceptedExtensions"
                   disabled="@IsDisabled"
                   webkitdirectory="@AllowFolderUpload"
                   directory="@AllowFolderUpload"
                   OnChange="HandleFilesSelectedAsync" />
        <span class="image-upload-prompt">@PromptText</span>
        <span class="image-upload-hint">
            @(AllowFolderUpload ? FolderHintText : AcceptedExtensions)
        </span>
    </label>

    @if (!string.IsNullOrWhiteSpace(_validationError))
    {
        <span class="image-upload-error" role="alert" aria-live="polite">@_validationError</span>
    }

    @if (_selectedCount > 0 || _previews.Count > 0)
    {
        <Row HorizontalArrangement="Arrangement.SpaceBetween"
             VerticalAlignment="VerticalAlignment.Center"
             Modifier="@(UIModifier.New.FillMaxWidth())">
            <Text Value="@BuildSelectionSummaryText()"
                  Variant="TypographyVariant.Caption"
                  Muted="true" />
            <ActionButton Variant="ActionButton.ButtonVariant.Outline"
                          Size="ActionButton.ButtonSize.Small"
                          Text="@ClearButtonText"
                          IsDisabled="@IsDisabled"
                          OnClick="ClearAsync" />
        </Row>
    }

    @if (ShowPreview && _previews.Count > 0)
    {
        <div class="image-upload-previews">
            @foreach (var preview in _previews)
            {
                <div class="image-upload-preview-card">
                    <img class="image-upload-preview-img" src="@preview.DataUrl" alt="@preview.Name" />
                    <span class="image-upload-preview-name" title="@preview.Name">@preview.Name</span>
                </div>
            }
        </div>
    }
</div>

@code {
    private const int BytesPerMegabyte = 1024 * 1024;
    private const int DefaultMaxPreviewBytes = 5 * BytesPerMegabyte;

    /// <summary>Allow selecting multiple images.</summary>
    [Parameter] public bool AllowMultiple { get; set; } = true;

    /// <summary>Allow selecting an entire folder including all nested subfolders.</summary>
    [Parameter] public bool AllowFolderUpload { get; set; }

    /// <summary>Comma-separated list of accepted image extensions.</summary>
    [Parameter] public string AcceptedExtensions { get; set; } = ".png,.jpg,.jpeg,.gif,.webp,.svg,.bmp";

    /// <summary>Maximum allowed size per file in bytes.</summary>
    [Parameter] public long MaxFileSizeBytes { get; set; } = InputDefaults.FileUpload.DefaultMaxFileSizeBytes;

    /// <summary>Maximum number of files processed in a single selection.</summary>
    [Parameter] public int MaxAllowedFiles { get; set; } = 200;

    /// <summary>Prompt text displayed inside the dropzone.</summary>
    [Parameter] public string PromptText { get; set; } = "Tap to choose images";

    /// <summary>Hint text displayed inside the dropzone when folder selection is enabled.</summary>
    [Parameter] public string FolderHintText { get; set; } = "Select a folder (includes all subfolders)";

    /// <summary>Label for the button that clears the current image selection.</summary>
    [Parameter] public string ClearButtonText { get; set; } = "Clear";

    /// <summary>Optional formatter for the selected image count summary. Receives the selected count.</summary>
    [Parameter] public Func<int, string>? SelectionSummaryFormatter { get; set; }

    /// <summary>Format string for unsupported image format errors. Receives the file name as {0}.</summary>
    [Parameter] public string UnsupportedFormatErrorFormat { get; set; } = "'{0}' is not a supported image format.";

    /// <summary>Format string for oversized image errors. Receives the file name as {0} and the max size in MB as {1}.</summary>
    [Parameter] public string FileSizeExceededErrorFormat { get; set; } = "'{0}' exceeds the maximum size of {1} MB.";

    /// <summary>Whether to render thumbnail previews for selected images.</summary>
    [Parameter] public bool ShowPreview { get; set; } = true;

    /// <summary>Disables the upload control.</summary>
    [Parameter] public bool IsDisabled { get; set; }

    /// <summary>Invoked with all valid selected image files.</summary>
    [Parameter] public EventCallback<IReadOnlyList<IBrowserFile>> OnImagesSelected { get; set; }

    private string? _validationError;
    private int _selectedCount;
    private readonly List<ImagePreviewItem> _previews = [];

    private sealed record ImagePreviewItem(string Name, string DataUrl);

    /// <summary>
    /// Clears current validation errors, selection count, and thumbnail previews.
    /// </summary>
    public async Task ClearAsync()
    {
        _validationError = null;
        _selectedCount = 0;
        _previews.Clear();

        // Notify listeners so external selection state stays synchronized with the cleared UI.
        if (OnImagesSelected.HasDelegate)
        {
            await OnImagesSelected.InvokeAsync(Array.Empty<IBrowserFile>());
        }
    }

    private async Task HandleFilesSelectedAsync(InputFileChangeEventArgs args)
    {
        _validationError = null;
        _selectedCount = 0;
        _previews.Clear();

        var selectedFiles = (AllowMultiple || AllowFolderUpload)
            ? args.GetMultipleFiles(MaxAllowedFiles)
            : [args.File];

        var validFiles = new List<IBrowserFile>(selectedFiles.Count);
        foreach (var file in selectedFiles)
        {
            if (!IsExtensionAllowed(file.Name))
            {
                // Skip non-image files when scanning a folder; fail fast on explicit file picks.
                if (AllowFolderUpload)
                {
                    continue;
                }

                _validationError = string.Format(CultureInfo.CurrentCulture, UnsupportedFormatErrorFormat, file.Name);
                return;
            }

            if (file.Size > MaxFileSizeBytes)
            {
                _validationError = string.Format(
                    CultureInfo.CurrentCulture,
                    FileSizeExceededErrorFormat,
                    file.Name,
                    MaxFileSizeBytes / BytesPerMegabyte);
                return;
            }

            validFiles.Add(file);

            if (ShowPreview && file.Size <= DefaultMaxPreviewBytes)
            {
                await AddPreviewAsync(file);
            }
        }

        _selectedCount = validFiles.Count;

        if (OnImagesSelected.HasDelegate)
        {
            await OnImagesSelected.InvokeAsync(validFiles);
        }
    }

    private string BuildSelectionSummaryText()
    {
        // Use the caller's formatter when provided; otherwise fall back to English singular/plural phrasing.
        if (SelectionSummaryFormatter is not null)
        {
            return SelectionSummaryFormatter(_selectedCount);
        }

        return _selectedCount == 1
            ? "1 image selected"
            : $"{_selectedCount} images selected";
    }

    private async Task AddPreviewAsync(IBrowserFile file)
    {
        try
        {
            await using var stream = file.OpenReadStream(DefaultMaxPreviewBytes);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            var contentType = string.IsNullOrWhiteSpace(file.ContentType) ? "image/png" : file.ContentType;
            var base64 = Convert.ToBase64String(ms.ToArray());
            _previews.Add(new ImagePreviewItem(file.Name, $"data:{contentType};base64,{base64}"));
        }
        catch
        {
            // Ignore preview generation failures so valid file selection still succeeds.
        }
    }

    private bool IsExtensionAllowed(string fileName)
    {
        if (string.IsNullOrWhiteSpace(AcceptedExtensions))
        {
            return true;
        }

        var extension = Path.GetExtension(fileName);
        if (string.IsNullOrWhiteSpace(extension))
        {
            return false;
        }

        var allowed = AcceptedExtensions.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        return allowed.Any(ext => string.Equals(ext, extension, StringComparison.OrdinalIgnoreCase));
    }

    private string BuildWrapperCssClasses()
    {
        return new CssBuilder()
            .Add("image-upload")
            .Add("image-upload-disabled", IsDisabled)
            .AddRaw(ModifierClass)
            .Build();
    }
}
