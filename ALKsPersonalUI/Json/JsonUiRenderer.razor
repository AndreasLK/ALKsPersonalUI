@using ALKsPersonalUI.Json

@if (ResolvedRootNode is not null)
{
    @if (HasScopedTheme)
    {
        <div class="ui-json-runtime-scope" style="@ScopedThemeVariables">
            <div @key="ViewSubtreeKey">
                @RenderNode(ResolvedRootNode, 0)
            </div>
        </div>
    }
    else
    {
        <div @key="ViewSubtreeKey">
            @RenderNode(ResolvedRootNode, 0)
        </div>
    }
}

@code {
    private static readonly HashSet<string> LayoutNodeTypes = new(StringComparer.Ordinal)
    {
        "Column", "Row", "Box", "Grid", "Window", "TitledWindow", "Divider",
        "Spacer", "FrameBox", "TemplateSlot", "AspectRatioFrame", "PageCarousel", "KioskShell"
    };

    private static readonly HashSet<string> InputNodeTypes = new(StringComparer.Ordinal)
    {
        "ActionButton", "CloseButton", "ChoiceCard", "ScreenKeyboard", "TextInput",
        "TextArea", "SearchInput", "NumberInput", "Checkbox", "FileUpload", "ImageUpload"
    };

    private readonly JsonUiSessionState _sessionState = new();
    private JsonUiDocument? _activeDocument;
    private JsonUiDocument? _lastDocumentParam;
    private string? _lastJsonParam;
    private JsonUiNode? _lastNodeParam;
    private string? _lastDocumentId;

    /// <summary>
    /// Gets or sets a legacy root <see cref="JsonUiNode"/> for single-tree rendering.
    /// </summary>
    [Parameter] public JsonUiNode? Node { get; set; }

    /// <summary>
    /// Gets or sets a self-contained <see cref="JsonUiDocument"/> experience package.
    /// </summary>
    [Parameter] public JsonUiDocument? Document { get; set; }

    /// <summary>
    /// Gets or sets a raw JSON string representing a <see cref="JsonUiDocument"/>.
    /// </summary>
    [Parameter] public string? Json { get; set; }

    /// <summary>
    /// Gets or sets the backwards-compatible callback invoked by legacy <c>ActionButton</c> and <c>CloseButton</c> clicks.
    /// </summary>
    [Parameter] public EventCallback<string> OnAction { get; set; }

    /// <summary>
    /// Gets or sets the callback invoked when a declarative <see cref="JsonUiActionType.HostCommand"/> executes.
    /// </summary>
    [Parameter] public EventCallback<JsonUiHostCommand> OnHostCommand { get; set; }

    /// <summary>
    /// Gets or sets host-supplied data collections keyed by source name for components such as <c>Leaderboard</c>.
    /// </summary>
    [Parameter] public IReadOnlyDictionary<string, IReadOnlyList<IReadOnlyDictionary<string, object?>>>? DataSources { get; set; }

    private JsonUiNode? ResolvedRootNode =>
        _activeDocument is not null ? _activeDocument.ResolveViewNode(_sessionState.ActiveView) : Node;

    private string ScopedThemeVariables => JsonUiThemeResolver.ResolveScopedCssVariables(_activeDocument);
    private bool HasScopedTheme => !string.IsNullOrEmpty(ScopedThemeVariables);
    private string ViewSubtreeKey => $"{_sessionState.SessionGeneration}:{_sessionState.ActiveView}";

    protected override void OnParametersSet()
    {
        if (HasDocumentOrNodeChanged())
        {
            InitializeRuntimeFromParameters();
        }
    }

    private bool HasDocumentOrNodeChanged()
    {
        if (!ReferenceEquals(Document, _lastDocumentParam))
        {
            return true;
        }

        if (!string.Equals(Json, _lastJsonParam, StringComparison.Ordinal))
        {
            return true;
        }

        if (Document is null && string.IsNullOrWhiteSpace(Json) && !ReferenceEquals(Node, _lastNodeParam))
        {
            return true;
        }

        return Document is not null && !string.Equals(Document.Id, _lastDocumentId, StringComparison.Ordinal);
    }

    private void InitializeRuntimeFromParameters()
    {
        _lastDocumentParam = Document;
        _lastJsonParam = Json;
        _lastNodeParam = Node;
        _lastDocumentId = Document?.Id;

        _activeDocument = Document ?? (!string.IsNullOrWhiteSpace(Json) ? JsonUiDocument.FromJson(Json) : null);
        _sessionState.Reset(_activeDocument);
    }

    private RenderFragment RenderNode(JsonUiNode node, int depth) => __builder =>
    {
        if (depth > JsonUiDefaults.MaxRenderDepth || !JsonUiConditionEvaluator.Evaluate(node.VisibleWhen, _sessionState))
        {
            return;
        }

        var context = new JsonUiRenderContext(
            _sessionState,
            DataSources,
            DispatchNodeEventAsync,
            TriggerLegacyActionAsync,
            StateHasChanged,
            RenderNode);

        if (LayoutNodeTypes.Contains(node.Type))
        {
            <JsonUiLayoutNodeRenderer Node="@node" Context="@context" Depth="@depth" />
            return;
        }

        if (InputNodeTypes.Contains(node.Type))
        {
            <JsonUiInputNodeRenderer Node="@node" Context="@context" />
            return;
        }

        <JsonUiDisplayNodeRenderer Node="@node" Context="@context" Depth="@depth" />
    };

    private async Task DispatchNodeEventAsync(JsonUiNode node, string eventName, string? eventValue)
    {
        if (node.Events is null || !node.Events.TryGetValue(eventName, out var actions) || actions.Count == 0)
        {
            return;
        }

        await JsonUiActionDispatcher.DispatchAsync(
            actions,
            _sessionState,
            _activeDocument,
            OnHostCommand.HasDelegate ? cmd => OnHostCommand.InvokeAsync(cmd) : null,
            eventValue);

        StateHasChanged();
    }

    private async Task TriggerLegacyActionAsync(string actionName)
    {
        if (OnAction.HasDelegate)
        {
            await OnAction.InvokeAsync(actionName);
        }
    }
}
